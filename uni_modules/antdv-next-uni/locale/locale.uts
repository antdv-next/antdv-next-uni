// 语言包：结构与 antdv-next-mobile 的 locale 相同（组件名为键），内置简体中文与英文。
// 组件里的文案一律从这里取，不写死：`const locale = useAmLocale()`，`locale().Modal.okText`。
//
// 与 antdv-next-mobile 的差异：
// - UTS 的类型里不能放函数与元组：`DatePicker.rangePlaceholder` 拆成 rangeStartPlaceholder / rangeEndPlaceholder，
//   `Calendar.rangePrompt(maxRange)` 改成带 ${maxRange} 的模板字符串 `Calendar.rangePrompt`；
// - `Form.defaultValidateMessages` 只有最常用的 `required` 模板（${label} 为字段名）

export type AmLocaleCommon = {
	confirm : string
	cancel : string
	close : string
	loading : string
	reset : string
	done : string
	delete : string
	back : string
}

export type AmLocaleModal = {
	okText : string
	cancelText : string
	justOkText : string
}

export type AmLocalePopconfirm = {
	okText : string
	cancelText : string
}

export type AmLocaleActionSheet = {
	cancelText : string
}

export type AmLocalePicker = {
	okText : string
	cancelText : string
	placeholder : string
}

export type AmLocaleDatePicker = {
	placeholder : string
	rangeStartPlaceholder : string
	rangeEndPlaceholder : string
	year : string
	quarter : string
	month : string
	week : string
	day : string
	hour : string
	minute : string
	second : string
	am : string
	pm : string
}

export type AmLocaleTimePicker = {
	placeholder : string
}

export type AmLocaleCalendar = {
	title : string
	confirm : string
	today : string
	start : string
	end : string
	startEnd : string
	monthFormat : string
	/** 星期的名称，周日在前 */
	weekdays : string[]
	/** 超出可选天数时的提示，${maxRange} 为天数 */
	rangePrompt : string
}

export type AmLocaleCascader = {
	placeholder : string
	select : string
}

export type AmLocaleSelect = {
	placeholder : string
	notFoundContent : string
}

export type AmLocaleEmpty = {
	description : string
}

export type AmLocaleForm = {
	optional : string
	required : string
}

export type AmLocaleImage = {
	preview : string
	loadFailed : string
}

export type AmLocaleInput = {
	placeholder : string
	clear : string
}

export type AmLocaleInputSearch = {
	placeholder : string
	cancelText : string
}

export type AmLocalePullToRefresh = {
	pulling : string
	canRelease : string
	refreshing : string
	complete : string
}

export type AmLocaleInfiniteScroll = {
	loading : string
	noMore : string
	failed : string
	retry : string
}

export type AmLocaleUpload = {
	upload : string
	uploading : string
	uploadError : string
	removeFile : string
	previewFile : string
}

export type AmLocalePagination = {
	prev : string
	next : string
}

export type AmLocaleNumberKeyboard = {
	done : string
	delete : string
}

export type AmLocaleTypography = {
	expand : string
	collapse : string
	copy : string
	copied : string
}

export type AmLocaleSpin = {
	tip : string
}

export type AmLocaleDropdown = {
	confirm : string
	reset : string
}

export type AmLocale = {
	/** dayjs 风格的语言代码，如 zh-cn；空字符串表示“沿用上层 / 全局语言” */
	locale : string
	common : AmLocaleCommon
	Modal : AmLocaleModal
	Popconfirm : AmLocalePopconfirm
	ActionSheet : AmLocaleActionSheet
	Picker : AmLocalePicker
	DatePicker : AmLocaleDatePicker
	TimePicker : AmLocaleTimePicker
	Calendar : AmLocaleCalendar
	Cascader : AmLocaleCascader
	Select : AmLocaleSelect
	Empty : AmLocaleEmpty
	Form : AmLocaleForm
	Image : AmLocaleImage
	Input : AmLocaleInput
	InputSearch : AmLocaleInputSearch
	PullToRefresh : AmLocalePullToRefresh
	InfiniteScroll : AmLocaleInfiniteScroll
	Upload : AmLocaleUpload
	Pagination : AmLocalePagination
	NumberKeyboard : AmLocaleNumberKeyboard
	Typography : AmLocaleTypography
	Spin : AmLocaleSpin
	Dropdown : AmLocaleDropdown
}


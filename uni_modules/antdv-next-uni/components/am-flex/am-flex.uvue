<script setup lang="uts">
import { useAmTheme } from '../../theme/theme.uts'
import { provideAmSpace } from '../../utils/space.uts'

// 弹性布局（= antdv-next-mobile 的 Flex）：vertical、orientation（horizontal / vertical）、wrap、justify、align、
// flex（容器自己的 flex）、gap（small 8 / middle 16 / large 24，或像素数）同名同义；
// justify / align 是 CSS 的值（flex-start / center / space-between …）。
//
// 与 antdv-next-mobile 的差异（uni-app x 的限制）：
// - `gap`：Web 端是容器上的 CSS `gap`；**App 端的运行时不支持 gap，子元素要放进 <am-space-item>**（由它加外边距）；预设值取主题的
//   paddingXS / padding / paddingLG，数字（或数字字符串）按像素，其他 CSS 长度原样写入；
// - `wrap` 只有布尔值（true = wrap），没有 `component`（根节点只能是 view）；
// - 不写 align 时子元素拉伸（uvue 的 view 默认 align-items: stretch，与 CSS 的 normal 表现相同）
defineOptions({ name: 'AmFlex' })

const props = defineProps({
	vertical: { type: Boolean, default: false },
	orientation: { type: String, default: '' },
	wrap: { type: Boolean, default: false },
	justify: { type: String, default: '' },
	align: { type: String, default: '' },
	flex: { type: String, default: '' },
	gap: { type: [String, Number], default: '' },
	rootClass: { type: String, default: '' }
})

const theme = useAmTheme()

/** gap 的值（带单位）；没有写时为空 */
const gapValue = computed(() : string => {
	const gap = props.gap
	if (typeof gap == 'number') return (gap as number) + 'px'
	const text = gap as string
	if (text.length == 0) return ''
	if (text == 'small') return theme().paddingXS + 'px'
	if (text == 'middle' || text == 'medium') return theme().padding + 'px'
	if (text == 'large') return theme().paddingLG + 'px'
	return /^\d+(\.\d+)?$/.test(text) ? text + 'px' : text
})

// 给 <am-space-item> 的上下文：App 端的运行时不支持 CSS gap，间距由包着子元素的 <am-space-item> 加外边距
provideAmSpace(
	() : string => gapValue.value,
	() : boolean => props.vertical || props.orientation == 'vertical',
	() : boolean => props.wrap
)

const style = computed(() : string => {
	const vertical = props.vertical || props.orientation == 'vertical'
	let text = 'flex-direction:' + (vertical ? 'column' : 'row') + ';'
	if (props.justify.length > 0) text += 'justify-content:' + props.justify + ';'
	if (props.align.length > 0) text += 'align-items:' + props.align + ';'
	if (props.wrap) text += 'flex-wrap:wrap;'
	if (props.flex.length > 0) text += 'flex:' + props.flex + ';'
	// #ifdef WEB
	if (gapValue.value.length > 0) text += 'gap:' + gapValue.value + ';'
	// #endif
	return text
})
</script>

<template>
	<view :class="['am-flex', rootClass]" :style="style">
		<slot></slot>
	</view>
</template>

<style>
/* App 端 view 默认裁剪超出的内容（overflow: hidden），布局容器与 Web 一致不裁剪（徽标、阴影会伸出子元素） */
.am-flex { overflow: visible; }
</style>

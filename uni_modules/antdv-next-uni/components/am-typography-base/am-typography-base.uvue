<script setup lang="uts">
import { alphaColor, useAmTheme } from '../../theme/theme.uts'
import { useAmLocale } from '../../locale/locale.uts'
import { ellipsisStyle, maxLines } from '../../utils/ellipsis.uts'

// 排版的公共实现（= antdv-next-mobile 内部的 TypographyBase）：<am-typography-text> / <am-typography-title> /
// <am-typography-paragraph> 都只是把属性原样传给它，`variant` 决定字号与段间距。不直接使用。
//
// 属性的含义与差异见 am-typography-text 顶部的注释。
// 没有操作（展开 / 复制）时根节点就是一个 <text>（可以放进一行里）；有操作时是 view：文字 + 操作
defineOptions({ name: 'AmTypographyBase' })

const props = defineProps({
	/** text / title / paragraph */
	variant: { type: String, default: 'text' },
	level: { type: Number, default: 1 },
	text: { type: String, default: '' },
	type: { type: String, default: '' },
	disabled: { type: Boolean, default: false },
	mark: { type: Boolean, default: false },
	code: { type: Boolean, default: false },
	keyboard: { type: Boolean, default: false },
	underline: { type: Boolean, default: false },
	delete: { type: Boolean, default: false },
	strong: { type: Boolean, default: false },
	italic: { type: Boolean, default: false },
	ellipsis: { type: Boolean, default: false },
	rows: { type: Number, default: 1 },
	expandable: { type: Boolean, default: false },
	collapsible: { type: Boolean, default: false },
	expanded: { type: Boolean, default: false },
	copyable: { type: Boolean, default: false },
	copyText: { type: String, default: '' },
	rootClass: { type: String, default: '' }
})

const emit = defineEmits(['expand', 'update:expanded', 'copy'])

const theme = useAmTheme()
const locale = useAmLocale()

// ---------- 省略与展开 ----------
const expanded = ref(props.expanded)
watch(() : boolean => props.expanded, (value : boolean) => { expanded.value = value })

const canExpand = computed(() : boolean => props.ellipsis && (props.expandable || props.collapsible))
/** 当前是否截断 */
const truncated = computed(() : boolean => props.ellipsis && !expanded.value)
const lines = computed(() : number => truncated.value ? Math.max(1, props.rows) : 0)
/** 展开后只有 collapsible 才能再收起 */
const showExpand = computed(() : boolean => canExpand.value && (!expanded.value || props.collapsible))
const expandLabel = computed(() : string => expanded.value ? locale().Typography.collapse : locale().Typography.expand)

function onExpand(event : UniPointerEvent) {
	if (props.disabled) return
	expanded.value = !expanded.value
	emit('update:expanded', expanded.value)
	emit('expand', expanded.value, event)
}

// ---------- 复制 ----------
const copied = ref(false)
let copyTimer = 0
const copyLabel = computed(() : string => copied.value ? locale().Typography.copied : locale().Typography.copy)

function onCopy(event : UniPointerEvent) {
	if (props.disabled) return
	uni.setClipboardData({
		data: props.copyText.length > 0 ? props.copyText : props.text,
		success: (_) => {
			copied.value = true
			clearTimeout(copyTimer)
			copyTimer = setTimeout(() => { copied.value = false }, 3000)
		}
	})
	emit('copy', event)
}

onUnmounted(() => { clearTimeout(copyTimer) })

// ---------- 样式 ----------
const TITLE_SIZES : number[] = [32, 26, 22, 18, 16]
const TITLE_LINE_HEIGHTS : number[] = [1.25, 1.3, 1.35, 1.4, 1.5]

const hasAction = computed(() : boolean => showExpand.value || props.copyable)
/** 多行文字 + 操作：操作另起一行；单行时操作跟在文字后面 */
const stacked = computed(() : boolean => props.ellipsis && (props.rows > 1 || expanded.value))

const tone = computed(() : string => props.disabled ? 'disabled' : (props.type.length > 0 ? props.type : 'default'))

const textClasses = computed(() : string[] => {
	const list : string[] = ['am-typography', 'am-typography--' + props.variant, 'am-typography--' + tone.value]
	if (props.strong) list.push('am-typography--strong')
	if (props.italic) list.push('am-typography--italic')
	// App 端的 text-decoration-line 只能写一个值：两个都写时显示删除线
	if (props.delete) list.push('am-typography--delete')
	else if (props.underline) list.push('am-typography--underline')
	if (props.code) list.push('am-typography--code')
	else if (props.keyboard) list.push('am-typography--keyboard')
	return list
})

/** 字号、行高（标题按 level）与高亮的背景色（主题色加透明度，CSS 里算不了） */
const textStyle = computed(() : string => {
	let text = ''
	if (props.variant == 'title') {
		const index = Math.max(1, Math.min(5, props.level)) - 1
		text += 'font-size:' + TITLE_SIZES[index] + 'px;line-height:' + TITLE_LINE_HEIGHTS[index] + ';'
	}
	if (props.mark) text += 'background-color:' + alphaColor(theme().colorWarning, 35) + ';'
	text += ellipsisStyle(lines.value)
	return text
})

/** 段间距写在根节点上（标题是字号的一半，段落是一行字的高度） */
const spacingStyle = computed(() : string => {
	if (props.variant == 'title') {
		const index = Math.max(1, Math.min(5, props.level)) - 1
		return 'margin-bottom:' + Math.round(TITLE_SIZES[index] * 0.5) + 'px;'
	}
	if (props.variant == 'paragraph') return 'margin-bottom:' + theme().fontSize + 'px;'
	return ''
})

const rootTextClasses = computed(() : string[] => {
	const list : string[] = [...textClasses.value]
	if (props.rootClass.length > 0) list.push(props.rootClass)
	return list
})

const actionClass = computed(() : string[] => [
	'am-typography__action',
	props.disabled ? 'am-typography__action--disabled' : '',
	stacked.value ? '' : 'am-typography__action--inline'
])
</script>

<template>
	<text v-if="!hasAction" :class="rootTextClasses" :style="textStyle + spacingStyle" :max-lines="maxLines(lines)">{{ text }}</text>
	<view v-else :class="['am-typography-box', stacked ? '' : 'am-typography-box--inline', rootClass]" :style="spacingStyle">
		<text :class="[...textClasses, stacked ? '' : 'am-typography--shrink']" :style="textStyle" :max-lines="maxLines(lines)">{{ text }}</text>
		<view class="am-typography__actions">
			<text v-if="showExpand" :class="actionClass" @click="onExpand">{{ expandLabel }}</text>
			<text v-if="copyable" :class="actionClass" @click="onCopy">{{ copyLabel }}</text>
		</view>
	</view>
</template>

<style>
.am-typography { font-size: var(--am-font-size, 14px); line-height: 1.5715; }
.am-typography--title { font-weight: bold; }
.am-typography--shrink { flex-shrink: 1; }

.am-typography--default { color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.am-typography--secondary { color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.am-typography--success { color: var(--am-color-success, #52c41a); }
.am-typography--warning { color: var(--am-color-warning, #faad14); }
.am-typography--danger { color: var(--am-color-error, #ff4d4f); }
.am-typography--disabled { color: var(--am-color-text-quaternary, rgba(0, 0, 0, 0.25)); }

.am-typography--strong { font-weight: bold; }
.am-typography--italic { font-style: italic; }
.am-typography--delete { text-decoration-line: line-through; }
.am-typography--underline { text-decoration-line: underline; }
.am-typography--code {
	padding-left: 6px;
	padding-right: 6px;
	background-color: var(--am-color-fill-secondary, rgba(0, 0, 0, 0.06));
	border-width: 1px;
	border-style: solid;
	border-color: var(--am-color-border-secondary, #f0f0f0);
	border-radius: 4px;
}
.am-typography--keyboard {
	padding-left: 6px;
	padding-right: 6px;
	background-color: var(--am-color-fill-quaternary, rgba(0, 0, 0, 0.02));
	border-width: 1px;
	border-bottom-width: 2px;
	border-style: solid;
	border-color: var(--am-color-border, #d9d9d9);
	border-radius: 4px;
}

.am-typography-box--inline { flex-direction: row; align-items: center; }
.am-typography__actions { flex-direction: row; align-items: center; flex-shrink: 0; }
.am-typography__action {
	margin-right: 12px;
	font-size: var(--am-font-size, 14px);
	line-height: 1.5715;
	color: var(--am-color-link, #1677ff);
}
.am-typography__action--inline { margin-right: 0; margin-left: 8px; }
.am-typography__action--disabled { color: var(--am-color-text-quaternary, rgba(0, 0, 0, 0.25)); }
</style>

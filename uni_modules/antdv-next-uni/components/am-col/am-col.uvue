<script setup lang="uts">
// 栅格列（= antdv-next-mobile 的 Col）：span（占 24 份中的几份，0 为不显示）、offset（左侧空几份）、
// push / pull（向右 / 向左移动几份）、flex（1、'100px'、'auto'、'none'、'1 1 200px'）同名同义；放在 <am-row> 中。
//
// 与 antdv-next-mobile 的差异（uni-app x 的限制）：
// - span / offset / push / pull 只有数字，flex 是字符串（UTS 的属性不能是 number | string 的联合类型）；
// - 没有 `order`：App 端没有 CSS 的 order；
// - 没写 span 也没写 flex 时占满一行（span = 24）
defineOptions({ name: 'AmCol' })

const props = defineProps({
	span: { type: Number, default: -1 },
	offset: { type: Number, default: 0 },
	push: { type: Number, default: 0 },
	pull: { type: Number, default: 0 },
	flex: { type: String, default: '' },
	rootClass: { type: String, default: '' }
})

const gutter = inject<(() => number) | null>('amRowGutter', null)
const verticalGutter = inject<(() => number) | null>('amRowVerticalGutter', null)

/** 24 份中的几份 → 百分比 */
function percent(cells : number) : string {
	return (Math.max(0, Math.min(24, cells)) / 24) * 100 + '%'
}

/** flex 的写法同 Antdv Next：数字是 `n n auto`，长度是 `0 0 长度`，其余原样（展开来写，App 端对简写的支持不全） */
function flexStyle(flex : string) : string {
	if (flex == 'auto') return 'flex-grow:1;flex-shrink:1;flex-basis:auto;'
	if (flex == 'none') return 'flex-grow:0;flex-shrink:0;flex-basis:auto;'
	if (flex.indexOf(' ') >= 0) return 'flex:' + flex + ';'
	const n = parseFloat(flex)
	if (!isNaN(n) && n.toString() == flex) return 'flex-grow:' + n + ';flex-shrink:' + n + ';flex-basis:auto;'
	return 'flex-grow:0;flex-shrink:0;flex-basis:' + flex + ';'
}

const hidden = computed(() : boolean => props.span == 0)

const style = computed(() : string => {
	let text = ''
	if (props.flex.length > 0) {
		text += flexStyle(props.flex)
		if (props.span > 0) text += 'width:' + percent(props.span) + ';'
	} else {
		text += 'width:' + percent(props.span < 0 ? 24 : props.span) + ';'
	}
	if (props.offset > 0) text += 'margin-left:' + percent(props.offset) + ';'
	if (props.push > 0) text += 'left:' + percent(props.push) + ';'
	else if (props.pull > 0) text += 'right:' + percent(props.pull) + ';'
	const half = gutter == null ? 0 : gutter() / 2
	if (half > 0) text += 'padding-left:' + half + 'px;padding-right:' + half + 'px;'
	const halfY = verticalGutter == null ? 0 : verticalGutter() / 2
	if (halfY > 0) text += 'padding-top:' + halfY + 'px;padding-bottom:' + halfY + 'px;'
	return text
})
</script>

<template>
	<view v-if="!hidden" :class="['am-col', rootClass]" :style="style">
		<slot></slot>
	</view>
</template>

<style>
/* App 端 view 默认裁剪超出的内容（overflow: hidden），布局容器与 Web 一致不裁剪（徽标、阴影会伸出子元素） */
.am-col { position: relative; overflow: visible; }
</style>

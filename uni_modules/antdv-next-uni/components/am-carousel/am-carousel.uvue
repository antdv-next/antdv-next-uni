<script setup lang="uts">
// 走马灯（= antdv-next-mobile 的 Carousel）：autoplay、autoplaySpeed（毫秒）、dots、dotPlacement（dotPosition 为旧名）、
// infinite、speed（切换动画的毫秒数）、initialSlide、vertical、draggable、allowTouchMove 同名同义；
// 事件 beforeChange（current, next）、afterChange（current）；方法 goTo(slide, dontAnimate)、next()、prev()、resize()。
//
// 与 antdv-next-mobile 的差异（uni-app x 的限制）：
// - 基于内置的 swiper（各端原生实现，手势与惯性都是原生的）：默认插槽里每一页要用 <swiper-item> 包起来
//   （移动端库是“每个直接子节点就是一页”，这里拿不到插槽里有几个节点）；只是轮播图片时直接传 `images`；
// - swiper 必须有确定的高度：`height`（像素，默认 160）；
// - 指示点是 swiper 自带的：只能在底部（横向）或末端（纵向），dotPlacement 为 start / end 时只表示纵向滑动；
//   没有自定义指示器（`indicator`）、指示点上的进度（autoplay 的 { dotDuration }）、`dots` 的 { class }；
// - 没有 `effect="fade"`、`slideSize` / `trackOffset` / `stuckAtBoundary`（露出相邻页）、`stopPropagation`
//   （嵌套的手势由原生处理）；
// - 拿不到页数：用插槽时 next() 在最后一页、prev() 在第一页不会绕回去（用 `images` 时会）；
//   beforeChange 在滑动结束、页码变化时触发（原生的滑动开始前没有事件），afterChange 在动画结束后触发
defineOptions({ name: 'AmCarousel' })

const props = defineProps({
	autoplay: { type: Boolean, default: false },
	autoplaySpeed: { type: Number, default: 3000 },
	dots: { type: Boolean, default: true },
	dotPlacement: { type: String, default: '' },
	dotPosition: { type: String, default: '' },
	infinite: { type: Boolean, default: true },
	speed: { type: Number, default: 300 },
	initialSlide: { type: Number, default: 0 },
	vertical: { type: Boolean, default: false },
	draggable: { type: Boolean, default: true },
	allowTouchMove: { type: Boolean, default: true },
	/** 高度（像素） */
	height: { type: Number, default: 160 },
	/** 图片轮播：每张图一页（也可以在默认插槽里自己写 <swiper-item>） */
	images: { type: Array as PropType<string[]>, default: () : string[] => [] },
	rootClass: { type: String, default: '' }
})

const emit = defineEmits(['beforeChange', 'afterChange', 'click'])

const current = ref(props.initialSlide)
/** goTo(slide, true) 时暂时把动画时长设为 0 */
const instant = ref(false)

const mergedVertical = computed(() : boolean => {
	if (props.vertical) return true
	const placement = props.dotPlacement.length > 0 ? props.dotPlacement : props.dotPosition
	return placement == 'start' || placement == 'end' || placement == 'left' || placement == 'right'
})
const duration = computed(() : number => instant.value ? 0 : props.speed)
const touchable = computed(() : boolean => props.draggable && props.allowTouchMove)

function onChange(event : UniSwiperChangeEvent) {
	const next = event.detail.current
	if (next == current.value) return
	const previous = current.value
	current.value = next
	emit('beforeChange', previous, next)
}

function onFinish(event : UniSwiperAnimationFinishEvent) {
	instant.value = false
	emit('afterChange', event.detail.current)
}

function goTo(slide : number, dontAnimate : boolean) {
	if (slide < 0 || slide == current.value) return
	const previous = current.value
	instant.value = dontAnimate
	current.value = slide
	emit('beforeChange', previous, slide)
}

function next() {
	const total = props.images.length
	if (total > 0 && current.value >= total - 1) {
		if (props.infinite) goTo(0, false)
		return
	}
	goTo(current.value + 1, false)
}

function prev() {
	if (current.value <= 0) {
		const total = props.images.length
		if (props.infinite && total > 0) goTo(total - 1, false)
		return
	}
	goTo(current.value - 1, false)
}

/** 与移动端库的 CarouselRef 对齐：原生 swiper 自己处理尺寸变化，这里不用做什么 */
function resize() {}

defineExpose({ goTo, next, prev, resize })
</script>

<template>
	<swiper
		:class="['am-carousel', rootClass]"
		:style="'height:' + height + 'px;'"
		:current="current"
		:autoplay="autoplay"
		:interval="autoplaySpeed"
		:duration="duration"
		:circular="infinite"
		:vertical="mergedVertical"
		:disable-touch="!touchable"
		:indicator-dots="dots"
		indicator-color="rgba(255, 255, 255, 0.5)"
		indicator-active-color="#ffffff"
		@change="onChange"
		@animationfinish="onFinish"
	>
		<swiper-item v-for="(image, index) in images" :key="index" @click="emit('click', index)">
			<image class="am-carousel__image" :src="image" mode="aspectFill" />
		</swiper-item>
		<slot></slot>
	</swiper>
</template>

<style>
.am-carousel { width: 100%; }
.am-carousel__image { width: 100%; height: 100%; }
</style>

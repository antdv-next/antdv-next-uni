<script setup lang="uts">
import { AM_AVATAR_GROUP_NO_MAX, AmAvatarGroupMax } from '../../types/avatar-group.uts'
import { mixColor, useAmTheme } from '../../theme/theme.uts'
import { useAmSize } from '../../utils/config.uts'

// 头像组（= antdv-next-mobile 的 AvatarGroup）：一排互相压着一点的头像。max（{ count }：最多显示几个，
// 其余的折叠成 “+N”）、size、shape（组里每个头像的尺寸与形状，头像自己写的优先）同名同义；
// 插槽 default（若干 <am-avatar>）、overflow（自定义 “+N” 里的内容，参数 { count }）。
//
// 与 antdv-next-mobile 的差异（uni-app x 的限制）：
// - 容器包不了、也数不了插槽里的子元素：头像在 setup 里向组登记，重叠（负的起始外边距）、描边、超出 max.count 后
//   隐藏都由 <am-avatar> 自己完成，所以默认插槽里只有 <am-avatar> 会参与（隔着别的组件也可以）；
//   登记的顺序是 setup 的顺序，之后用 v-if 插到中间的头像会被当成最后一个；
// - 多了 `total`：“+N” 默认按登记的头像数算；只渲染了前几个头像而总数更多时（成员列表只取了第一页），
//   用 total 写总人数；
// - 描边是 2px 的边框（不是向外扩的 box-shadow：App 端的阴影没有扩展半径），头像的盒子因此各大 4px；
// - `size` 是字符串：像素写成 size="64"；`max` 没有 style，要在 script 里按类型声明（AmAvatarGroupMax）
defineOptions({ name: 'AmAvatarGroup' })

const props = defineProps({
	max: { type: Object as PropType<AmAvatarGroupMax>, default: () : AmAvatarGroupMax => AM_AVATAR_GROUP_NO_MAX },
	size: { type: String, default: '' },
	shape: { type: String, default: '' },
	/** 头像的总数（算 “+N” 用）；0 为按默认插槽里登记的头像数 */
	total: { type: Number, default: 0 },
	rootClass: { type: String, default: '' }
})

const theme = useAmTheme()

/** 登记了的头像，按登记的先后 */
const ids = ref<number[]>([])
let seed = 0
// “+N” 用的头像数单独存一份，登记之后的下一拍再更新：头像是在根节点渲染的过程中登记的，
// 根节点里的 “+N” 如果直接读 ids，就成了“渲染时改自己依赖的数据”
const registered = ref(0)
function syncRegistered() {
	nextTick(() => { registered.value = ids.value.length })
}

const limit = computed(() : number => {
	const count = props.max.count
	return count != null && count >= 0 ? count : -1
})

provide('amAvatarGroupRegister', () : number => {
	seed++
	ids.value = [...ids.value, seed]
	syncRegistered()
	return seed
})
provide('amAvatarGroupUnregister', (id : number) => {
	ids.value = ids.value.filter((item : number) : boolean => item != id)
	syncRegistered()
})
/** 这个头像是否排在 max.count 之后（不显示） */
provide('amAvatarGroupHidden', (id : number) : boolean => limit.value >= 0 && ids.value.indexOf(id) >= limit.value)
provide('amAvatarGroupSize', () : string => props.size)
provide('amAvatarGroupShape', () : string => props.shape)

/** 折叠掉的个数 */
const rest = computed(() : number => {
	if (limit.value < 0) return 0
	const all = props.total > 0 ? props.total : registered.value
	return Math.max(0, all - Math.min(registered.value, limit.value))
})

// ---------- “+N”：和组里的头像一样大 ----------
const customSize = computed(() : number => {
	const n = parseFloat(props.size)
	return isNaN(n) ? 0 : n
})
const sizeOf = useAmSize(() : string => customSize.value > 0 ? 'middle' : props.size)
const pixels = computed(() : number => {
	if (customSize.value > 0) return customSize.value
	const size = sizeOf()
	return size == 'small' ? 28 : (size == 'large' ? 56 : 40)
})

const overflowStyle = computed(() : string => {
	const current = theme()
	const box = pixels.value + 4
	let radius = box / 2
	if (props.shape == 'square') radius = current.borderRadius + 2
	return 'width:' + box + 'px;height:' + box + 'px;border-radius:' + radius + 'px;border-color:' + current.colorBgContainer +
		';background-color:' + mixColor(current.colorTextBase, 15, current.colorBgContainer) + ';'
})
const overflowTextStyle = computed(() : string => 'font-size:' + Math.max(10, Math.round(pixels.value * 0.35)) + 'px;')
</script>

<template>
	<view :class="['am-avatar-group', rootClass]">
		<slot></slot>
		<view v-if="rest > 0" class="am-avatar-group__overflow" :style="overflowStyle">
			<slot name="overflow" :count="rest">
				<text class="am-avatar-group__overflow-text" :style="overflowTextStyle">+{{ rest }}</text>
			</slot>
		</view>
	</view>
</template>

<style>
/* 每个头像（含第一个）都有 -12px 的起始外边距，这里用内边距把第一个抵回来；头像互相压着，不能裁剪 */
.am-avatar-group { flex-direction: row; align-items: center; align-self: flex-start; padding-left: 12px; overflow: visible; }
.am-avatar-group__overflow {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	margin-left: -12px;
	border-width: 2px;
	border-style: solid;
}
.am-avatar-group__overflow-text { white-space: nowrap; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
</style>

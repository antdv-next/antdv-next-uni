<script setup lang="uts">
import { useAmTheme } from '../../theme/theme.uts'
import { useAmFieldBlur, useAmFieldChange, useAmFieldDisabled, useAmFieldStatus, useAmFieldVariant } from '../../utils/form-field.uts'

// 密码框（= antdv-next-mobile 的 InputPassword）：一个 <am-input> 加上“显示 / 隐藏密码”的按钮。
// v-model:value、placeholder、disabled、readOnly、maxlength、showCount、allowClear、prefix、suffix、size、status、variant、
// enterkeyhint、autofocus、name、id、align、visibilityToggle、v-model:iconVisible 同名同义；
// 事件 update:value、update:iconVisible、change、input、pressEnter、focus、blur、clear；方法 focus()、blur()；
// 插槽 prefix、suffix、clearIcon、iconRender（参数 visible）。
//
// 与 antdv-next-mobile 的差异（uni-app x 的限制）：
// - 没有 `iconRender` 属性（渲染函数），自定义图标用 `iconRender` 插槽；
// - `iconVisible` 没有“没传”的状态：不用 v-model:iconVisible 时由组件自己记着显示与否，
//   传了 true 之后要靠 update:iconVisible 改回去（即受控）；
// - 其余同 <am-input>：prefix / suffix 是字符串，change / input 的参数是值，没有 defaultValue、readonly、
//   clearTrigger、inputmode、autocomplete
defineOptions({ name: 'AmInputPassword' })

const props = defineProps({
	value: { type: String, default: '' },
	placeholder: { type: String, default: '' },
	disabled: { type: Boolean, default: false },
	readOnly: { type: Boolean, default: false },
	maxlength: { type: Number, default: -1 },
	showCount: { type: Boolean, default: false },
	allowClear: { type: Boolean, default: false },
	prefix: { type: String, default: '' },
	suffix: { type: String, default: '' },
	size: { type: String, default: '' },
	status: { type: String, default: '' },
	/** outlined / filled / borderless / underlined；空为表单的 variant，再没有则 outlined */
	variant: { type: String, default: '' },
	enterkeyhint: { type: String, default: 'done' },
	autofocus: { type: Boolean, default: false },
	name: { type: String, default: '' },
	id: { type: String, default: '' },
	align: { type: String, default: 'start' },
	/** 是否显示“显示 / 隐藏密码”的按钮 */
	visibilityToggle: { type: Boolean, default: true },
	/** 密码是否以明文显示（v-model:iconVisible） */
	iconVisible: { type: Boolean, default: false },
	rootClass: { type: String, default: '' }
})

const emit = defineEmits(['update:value', 'update:iconVisible', 'change', 'input', 'pressEnter', 'focus', 'blur', 'clear'])

const theme = useAmTheme()
const disabledOf = useAmFieldDisabled(() : boolean => props.disabled)
const disabled = computed(() : boolean => disabledOf())
const statusOf = useAmFieldStatus(() : string => props.status)
const status = computed(() : string => statusOf())
const variantOf = useAmFieldVariant(() : string => props.variant)
const variant = computed(() : string => variantOf())
const notifyChange = useAmFieldChange()
const notifyBlur = useAmFieldBlur()

const inputRef = ref<AmInputComponentPublicInstance | null>(null)
/** 没有用 v-model:iconVisible 时自己记着 */
const innerVisible = ref(props.iconVisible)
watch(() : boolean => props.iconVisible, (visible : boolean) => {
	innerVisible.value = visible
})

const iconColor = computed(() : string => theme().colorTextTertiary)
const clearColor = computed(() : string => theme().colorTextQuaternary)

function toggle() {
	if (disabled.value) return
	const next = !innerVisible.value
	innerVisible.value = next
	emit('update:iconVisible', next)
}

function onUpdate(value : string) {
	emit('update:value', value)
	notifyChange()
}

function onChange(value : string) {
	emit('change', value)
}

function onInput(value : string) {
	emit('input', value)
}

function onPressEnter(value : string) {
	emit('pressEnter', value)
}

function onFocus(event : UniInputFocusEvent) {
	emit('focus', event)
}

function onBlur(event : UniInputBlurEvent) {
	emit('blur', event)
	notifyBlur()
}

function onClear() {
	emit('clear')
}

function focus() {
	inputRef.value?.focus()
}

function blur() {
	inputRef.value?.blur()
}

defineExpose({ focus, blur })
</script>

<template>
	<am-input
		ref="inputRef"
		:value="value"
		:type="innerVisible ? 'text' : 'password'"
		:placeholder="placeholder"
		:disabled="disabled"
		:read-only="readOnly"
		:maxlength="maxlength"
		:show-count="showCount"
		:allow-clear="allowClear"
		:prefix="prefix"
		:suffix="suffix"
		:size="size"
		:status="status"
		:variant="variant"
		:enterkeyhint="enterkeyhint"
		:autofocus="autofocus"
		:name="name"
		:id="id"
		:align="align"
		:root-class="rootClass"
		@update:value="onUpdate"
		@change="onChange"
		@input="onInput"
		@pressEnter="onPressEnter"
		@focus="onFocus"
		@blur="onBlur"
		@clear="onClear"
	>
		<template #prefix>
			<slot name="prefix"></slot>
		</template>
		<template #clearIcon>
			<slot name="clearIcon">
				<am-icon name="error-fill" :size="16" :color="clearColor" />
			</slot>
		</template>
		<template #suffix>
			<slot name="suffix"></slot>
			<view v-if="visibilityToggle" class="am-input-password__toggle" @click="toggle">
				<slot name="iconRender" :visible="innerVisible">
					<am-icon :name="innerVisible ? 'eye' : 'eye-off'" :size="18" :color="iconColor" />
				</slot>
			</view>
		</template>
	</am-input>
</template>

<style>
.am-input-password__toggle { margin-left: 8px; padding: 2px; }
</style>

// 同一时刻只有一个滑动单元格是打开的（同 Vant、微信）：打开一个时先关掉上一个

type AmSwipeOpened = {
	id : number
	close : () => void
}

let opened : AmSwipeOpened | null = null

/** 单元格打开时登记：关掉之前打开的另一个 */
export function amSwipeOpen(id : number, close : () => void) : void {
	const previous = opened
	if (previous != null && previous.id != id) previous.close()
	opened = { id: id, close: close }
}

/** 单元格关上时注销 */
export function amSwipeClosed(id : number) : void {
	const current = opened
	if (current != null && current.id == id) opened = null
}

/** 关掉打开着的单元格（列表滚动、切换页签时可以调用）；有打开的时返回 true */
export function closeApSwipe() : boolean {
	const current = opened
	if (current == null) return false
	opened = null
	current.close()
	return true
}

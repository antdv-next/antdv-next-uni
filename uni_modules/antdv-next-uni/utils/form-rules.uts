import { AmFormRule } from '../types/form.uts'
import { isEmptyValue } from './value.uts'

// 表单规则的校验（= antdv-next-mobile 用的 @v-c/async-validator，这里是同步的 UTS 实现）。
// 提示文字的模板与 antdv-next-mobile 的 locale `Form.defaultValidateMessages` 相同；
// 本库的语言包里只有 `Form.required`，其余的模板先放在这里（按语言代码选中文 / 英文），rule.message 优先

type AmRuleMessages = {
	whitespace : string
	type : string
	stringLen : string
	stringMin : string
	stringMax : string
	stringRange : string
	numberLen : string
	numberMin : string
	numberMax : string
	numberRange : string
	arrayLen : string
	arrayMin : string
	arrayMax : string
	arrayRange : string
	pattern : string
}

const MESSAGES_ZH : AmRuleMessages = {
	whitespace: '${label}不能为空字符',
	type: '${label}不是一个有效的${type}',
	stringLen: '${label}须为${len}个字符',
	stringMin: '${label}最少${min}个字符',
	stringMax: '${label}最多${max}个字符',
	stringRange: '${label}须在${min}-${max}字符之间',
	numberLen: '${label}必须等于${len}',
	numberMin: '${label}最小值为${min}',
	numberMax: '${label}最大值为${max}',
	numberRange: '${label}须在${min}-${max}之间',
	arrayLen: '须为${len}个${label}',
	arrayMin: '最少${min}个${label}',
	arrayMax: '最多${max}个${label}',
	arrayRange: '${label}数量须在${min}-${max}之间',
	pattern: '${label}与模式不匹配${pattern}'
}

const MESSAGES_EN : AmRuleMessages = {
	whitespace: '${label} cannot be a blank character',
	type: '${label} is not a valid ${type}',
	stringLen: '${label} must be ${len} characters',
	stringMin: '${label} must be at least ${min} characters',
	stringMax: '${label} must be up to ${max} characters',
	stringRange: '${label} must be between ${min}-${max} characters',
	numberLen: '${label} must be equal to ${len}',
	numberMin: '${label} must be minimum ${min}',
	numberMax: '${label} must be maximum ${max}',
	numberRange: '${label} must be between ${min}-${max}',
	arrayLen: 'Must be ${len} ${label}',
	arrayMin: 'At least ${min} ${label}',
	arrayMax: 'At most ${max} ${label}',
	arrayRange: 'The amount of ${label} must be between ${min}-${max}',
	pattern: '${label} does not match the pattern ${pattern}'
}

const EMAIL_PATTERN = /^[\w.%+-]+@[a-z\d-]+(?:\.[a-z\d-]+)*\.[a-z]{2,}$/i
const URL_PATTERN = /^https?:\/\/[^\s/?#]+([/?#]\S*)?$/i
const HEX_PATTERN = /^#?([a-f0-9]{6}|[a-f0-9]{3})$/i
const TEL_PATTERN = /^(\+\d{1,3}[- ]?)?(0\d{2,3}-?)?\d{5,11}(-\d{1,6})?$/

/** 任意对象 → UTSJSONObject（带类型的对象、Web 上解析出来的嵌套对象都不一定是它的实例，统一走 JSON） */
export function toJSONObject(value : any | null) : UTSJSONObject {
	if (value == null) return {} as UTSJSONObject
	return JSON.parseObject(JSON.stringify(value) ?? '{}') ?? ({} as UTSJSONObject)
}

function replaceAll(template : string, name : string, value : string) : string {
	return template.split('${' + name + '}').join(value)
}

/** 数字显示成文字：整数不带小数点 */
function numberText(value : number) : string {
	return value == Math.floor(value) ? value.toFixed(0) : '' + value
}

function fill(template : string, label : string, rule : AmFormRule, type : string) : string {
	let text = replaceAll(template, 'label', label)
	text = replaceAll(text, 'type', type)
	const len = rule.len
	if (len != null) text = replaceAll(text, 'len', numberText(len))
	const min = rule.min
	if (min != null) text = replaceAll(text, 'min', numberText(min))
	const max = rule.max
	if (max != null) text = replaceAll(text, 'max', numberText(max))
	text = replaceAll(text, 'pattern', rule.pattern ?? '')
	return text
}

/** 没写 type 时按值推断（async-validator 一律当作 string，数字、数组的值就报“不是有效的 string”） */
function typeOfValue(rule : AmFormRule, value : any | null) : string {
	const type = rule.type ?? ''
	if (type.length > 0) return type
	if (typeof value == 'number') return 'number'
	if (typeof value == 'boolean') return 'boolean'
	if (Array.isArray(value)) return 'array'
	if (typeof value == 'string') return 'string'
	return 'object'
}

function matchType(type : string, value : any | null) : boolean {
	if (type == 'string') return typeof value == 'string'
	if (type == 'number') return typeof value == 'number'
	if (type == 'integer') return typeof value == 'number' && (value as number) == Math.floor(value as number)
	if (type == 'float') return typeof value == 'number' && (value as number) != Math.floor(value as number)
	if (type == 'boolean') return typeof value == 'boolean'
	if (type == 'array') return Array.isArray(value)
	if (type == 'email') return typeof value == 'string' && EMAIL_PATTERN.test(value as string)
	if (type == 'url') return typeof value == 'string' && URL_PATTERN.test(value as string)
	if (type == 'hex') return typeof value == 'string' && HEX_PATTERN.test(value as string)
	if (type == 'tel') return typeof value == 'string' && TEL_PATTERN.test(value as string)
	return true
}

/**
 * 用一条规则校验一个值：通过时返回空字符串，否则返回错误说明。
 * requiredTemplate 是语言包的 `Form.required`（带 ${label}），zh 为 true 时其余的提示用中文
 */
export function validateAmRule(rule : AmFormRule, value : any | null, label : string, requiredTemplate : string, zh : boolean) : string {
	const messages = zh ? MESSAGES_ZH : MESSAGES_EN
	const custom = rule.message ?? ''
	const type = typeOfValue(rule, value)
	const blank = typeof value == 'string' && (value as string).trim().length == 0
	const empty = isEmptyValue(value) || (rule.whitespace == true && blank)

	if (rule.required == true && empty) {
		return custom.length > 0 ? custom : fill(requiredTemplate, label, rule, type)
	}

	if (!isEmptyValue(value)) {
		if (rule.whitespace == true && blank) {
			return custom.length > 0 ? custom : fill(messages.whitespace, label, rule, type)
		}
		if (!matchType(type, value)) {
			return custom.length > 0 ? custom : fill(messages.type, label, rule, type)
		}

		// 长度 / 范围：字符串按字数，数字按大小，数组按项数
		let kind = ''
		let size = 0
		if (typeof value == 'string') {
			kind = 'string'
			size = (value as string).length
		} else if (typeof value == 'number') {
			kind = 'number'
			size = value as number
		} else if (Array.isArray(value)) {
			kind = 'array'
			size = (value as any[]).length
		}
		if (kind.length > 0) {
			const len = rule.len
			const min = rule.min
			const max = rule.max
			let template = ''
			if (len != null) {
				if (size != len) template = kind == 'string' ? messages.stringLen : (kind == 'number' ? messages.numberLen : messages.arrayLen)
			} else if (min != null && max != null) {
				if (size < min || size > max) template = kind == 'string' ? messages.stringRange : (kind == 'number' ? messages.numberRange : messages.arrayRange)
			} else if (min != null) {
				if (size < min) template = kind == 'string' ? messages.stringMin : (kind == 'number' ? messages.numberMin : messages.arrayMin)
			} else if (max != null) {
				if (size > max) template = kind == 'string' ? messages.stringMax : (kind == 'number' ? messages.numberMax : messages.arrayMax)
			}
			if (template.length > 0) return custom.length > 0 ? custom : fill(template, label, rule, type)
		}

		const pattern = rule.pattern ?? ''
		if (pattern.length > 0 && (typeof value == 'string' || typeof value == 'number')) {
			const text = typeof value == 'string' ? (value as string) : numberText(value as number)
			if (!new RegExp(pattern).test(text)) {
				return custom.length > 0 ? custom : fill(messages.pattern, label, rule, type)
			}
		}
	}

	// 自定义校验：空值也会调用（同 async-validator）
	const validator = rule.validator
	if (validator != null) {
		const result = validator(value)
		if (result.length > 0) return custom.length > 0 ? custom : result
	}
	return ''
}

/** 规则是否在这个时机（'change' / 'blur'）校验：规则自己的 trigger > fallback（表单项 / 表单的 validateTrigger） */
export function ruleHasTrigger(rule : AmFormRule, trigger : string, fallback : string) : boolean {
	const own = rule.trigger ?? ''
	const merged = own.length > 0 ? own : fallback
	const list = merged.split(',')
	for (let i = 0; i < list.length; i++) if (list[i].trim() == trigger) return true
	return false
}

/**
 * 表单级的规则（<am-form :rules="{ name: [{ required: true }] }">，UTSJSONObject）里某一项 → AmFormRule[]。
 * 这里的规则是纯数据，没有 validator（函数放不进 JSON），要自定义校验时把规则写在 <am-form-item :rules> 上
 */
export function toAmFormRules(list : any | null) : AmFormRule[] {
	const result : AmFormRule[] = []
	if (list == null || !Array.isArray(list)) return result
	const items = list as any[]
	for (let i = 0; i < items.length; i++) {
		const item = items[i]
		if (item == null) continue
		const object = toJSONObject(item)
		const rule : AmFormRule = {
			type: object.getString('type') ?? '',
			required: object.getBoolean('required') ?? false,
			whitespace: object.getBoolean('whitespace') ?? false,
			warningOnly: object.getBoolean('warningOnly') ?? false,
			message: object.getString('message') ?? '',
			pattern: object.getString('pattern') ?? '',
			trigger: object.getString('trigger') ?? ''
		}
		const len = object.getNumber('len')
		if (len != null) rule.len = len
		const min = object.getNumber('min')
		if (min != null) rule.min = min
		const max = object.getNumber('max')
		if (max != null) rule.max = max
		result.push(rule)
	}
	return result
}

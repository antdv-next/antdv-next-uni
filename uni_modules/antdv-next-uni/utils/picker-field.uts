// 选择类字段（Picker / DatePicker / TimePicker / Select / Cascader）与表单的约定，集中在这一处：
// - 值提交后（确定、清除）调用 change()，让外层的 FormItem 重新校验；
// - 弹层关闭算作失焦，调用 blur()。
// = antdv-next-mobile 的 usePickerField 里的 formItem.onFieldChange() / onFieldBlur()。
// 通知由表单的 utils/form-field.uts 提供；不在表单里时它们是空操作。
// 禁用 / 状态 / 变体与表单上下文的合并在 am-picker-trigger 里（所有选择器共用它）

import { useAmFieldBlur, useAmFieldChange } from './form-field.uts'

export type AmPickerFieldHooks = {
	change : () => void
	blur : () => void
}

/** 在选择器的 setup 中调用 */
export function useAmPickerField() : AmPickerFieldHooks {
	const hooks : AmPickerFieldHooks = {
		change: useAmFieldChange(),
		blur: useAmFieldBlur()
	}
	return hooks
}

/** 图标对应的字符；不认识的名称返回空字符串（不显示） */
export function iconGlyph(name : string) : string {
	const code = ICON_CODES.get(name)
	return code == null ? '' : String.fromCharCode(code)
}

let loaded = false

/**
 * 加载图标字体（App.uvue 的 onLaunch 中调用一次）。global 为 true 时全部页面可用；
 * 多次调用只加载一次
 */
export function loadAmIcons() : void {
	if (loaded) return
	loaded = true
	uni.loadFontFace({
		global: true,
		family: AM_ICON_FONT,
		source: "url('/uni_modules/antdv-next-uni/static/am-icons.ttf')",
		fail: (error) => {
			loaded = false
			console.error('[antdv-next-uni] 图标字体加载失败', error)
		}
	})
}

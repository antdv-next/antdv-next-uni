// 同一时刻只有一个滑动操作（am-swipe-action）是展开的：展开一个时先收起上一个。
// App 端没有“触摸组件以外的区域”这种全局事件，closeOnTouchOutside 由它实现；
// 列表滚动、切换页签时页面也可以调用 closeAmSwipeAction()

type AmSwipeActionOpened = {
	id : number
	close : () => void
}

let opened : AmSwipeActionOpened | null = null

/** 展开时登记：收起之前展开的另一个 */
export function amSwipeActionOpen(id : number, close : () => void) : void {
	const previous = opened
	if (previous != null && previous.id != id) previous.close()
	opened = { id: id, close: close }
}

/** 收起时注销 */
export function amSwipeActionClosed(id : number) : void {
	const current = opened
	if (current != null && current.id == id) opened = null
}

/** 收起展开着的那一个；有展开的时返回 true */
export function closeAmSwipeAction() : boolean {
	const current = opened
	if (current == null) return false
	opened = null
	current.close()
	return true
}

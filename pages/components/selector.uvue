<script setup lang="uts">
import { AmOption } from '@/uni_modules/antdv-next-uni/types/index.uts'

const fruits : AmOption[] = [
	{ label: '苹果', value: 'apple' },
	{ label: '香蕉', value: 'banana' },
	{ label: '橙子', value: 'orange' },
	{ label: '葡萄（售罄）', value: 'grape', disabled: true }
]
const plans : AmOption[] = [
	{ label: '月付', description: '¥ 30 / 月', value: 1 },
	{ label: '季付', description: '¥ 80 / 季', value: 3 },
	{ label: '年付', description: '¥ 288 / 年', value: 12 }
]
const amounts : string[] = ['10 元', '20 元', '50 元', '100 元', '200 元', '500 元']

const single = ref<any[]>(['apple'])
const multiple = ref<any[]>(['apple', 'orange'])
const plan = ref<any[]>([3])
const amount = ref<any[]>([])
const plain = ref<any[]>(['banana'])
const log = ref('')

// 表单的数据是响应式的 UTSJSONObject
const model = reactive<UTSJSONObject>({ fruit: [] })
const rules = {
	fruit: [{ required: true, message: '请至少选一种水果' }]
} as UTSJSONObject

function onChange(value : any[], extra : UTSJSONObject) {
	log.value = 'change: ' + JSON.stringify(value) + '，选中 ' + (extra.getArray('items')?.length ?? 0) + ' 项'
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">单选（再点一次取消）</text>
		<view class="demo__card">
			<am-selector v-model:value="single" :options="fruits" @change="onChange" />
			<text class="demo__hint">value = {{ JSON.stringify(single) }}　{{ log }}</text>
		</view>

		<text class="demo__title">多选</text>
		<view class="demo__card">
			<am-selector v-model:value="multiple" :options="fruits" multiple />
			<text class="demo__hint">value = {{ JSON.stringify(multiple) }}</text>
		</view>

		<text class="demo__title">按列排（columns）与说明文字</text>
		<view class="demo__card">
			<am-selector v-model:value="plan" :options="plans" :columns="3" />
			<view class="demo__gap"></view>
			<am-selector v-model:value="amount" :options="amounts" :columns="3" multiple />
		</view>

		<text class="demo__title">不显示对勾 / 禁用</text>
		<view class="demo__card">
			<am-selector v-model:value="plain" :options="fruits" :show-check-mark="false" />
			<view class="demo__gap"></view>
			<am-selector :value="single" :options="fruits" disabled />
		</view>

		<text class="demo__title">插槽（label / checkMark）</text>
		<view class="demo__card">
			<am-selector v-model:value="multiple" :options="fruits" multiple :columns="2">
				<template #label="{ option, checked }">
					<text :class="['demo__custom', checked ? 'demo__custom--checked' : '']">{{ checked ? '已选 ' : '' }}{{ option.label }}</text>
				</template>
				<template #checkMark>
					<am-icon name="star-fill" :size="8" color="#ffffff" />
				</template>
			</am-selector>
		</view>

		<text class="demo__title">在表单里（校验必选）</text>
		<am-form :model="model" :rules="rules">
			<am-form-item label="水果" name="fruit">
				<am-selector v-model:value="model['fruit']" :options="fruits" multiple />
			</am-form-item>
		</am-form>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
	overflow: visible;
}
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; overflow: visible; }
.demo__item { margin-right: 12px; margin-bottom: 10px; }
.demo__text { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__hint { padding-top: 8px; font-size: 12px; line-height: 18px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__footer { height: 40px; }
.demo__gap { height: 16px; }
.demo__custom { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__custom--checked { color: var(--am-color-primary, #1677ff); }
</style>

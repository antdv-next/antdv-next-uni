<script setup lang="uts">
const SRC = '/static/logo.png'
const fits : string[] = ['fill', 'contain', 'cover', 'none', 'scale-down']
const list : string[] = ['/static/logo.png', '/static/logo.png']
const log = ref('')
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card demo__row">
			<am-image class="demo__item" :src="SRC" :width="100" :height="100" />
			<am-image class="demo__item" :src="SRC" :width="100" :height="100" :radius="12" />
			<am-image class="demo__item" :src="SRC" :width="100" :height="100" round />
		</view>

		<text class="demo__title">填充方式（fit）</text>
		<view class="demo__card demo__row">
			<view v-for="fit in fits" :key="fit" class="demo__item demo__cell">
				<am-image :src="SRC" :width="96" :height="64" :fit="fit" />
				<text class="demo__hint">{{ fit }}</text>
			</view>
		</view>

		<text class="demo__title">只给宽度：按图片的比例定高度</text>
		<view class="demo__card">
			<am-image :src="SRC" :width="160" />
		</view>

		<text class="demo__title">点击预览（preview）</text>
		<view class="demo__card demo__row">
			<am-image class="demo__item" :src="SRC" :width="100" :height="100" preview @openChange="log = '打开了预览'" />
			<am-image class="demo__item" :src="SRC" :width="100" :height="100" preview :preview-list="list" />
			<text class="demo__hint">{{ log }}</text>
		</view>

		<text class="demo__title">加载失败</text>
		<view class="demo__card demo__row">
			<am-image class="demo__item" src="/static/not-found.png" :width="100" :height="100" @error="log = '加载失败'" />
			<am-image class="demo__item" src="/static/not-found.png" :fallback="SRC" :width="100" :height="100" />
			<am-image class="demo__item" src="/static/not-found.png" :width="100" :height="100">
				<template #fallback>
					<text class="demo__hint">自定义的失败提示</text>
				</template>
			</am-image>
		</view>

		<text class="demo__title">懒加载（lazy）</text>
		<view class="demo__card">
			<am-image :src="SRC" :width="100" :height="100" lazy />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.demo__item { margin-right: 12px; margin-bottom: 10px; }
.demo__block { margin-bottom: 12px; }
.demo__text { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__hint { margin-top: 8px; font-size: 12px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__footer { height: 40px; }
.demo__cell { align-items: center; }
</style>

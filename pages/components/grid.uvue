			<am-row :wrap="false">
				<am-col flex="2"><view class="demo__cell"><text class="demo__cell-text">2</text></view></am-col>
				<am-col flex="3"><view class="demo__cell demo__cell--light"><text class="demo__cell-text">3</text></view></am-col>
			</am-row>
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>


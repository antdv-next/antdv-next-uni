<script setup lang="uts">
import { AmOption } from '@/uni_modules/antdv-next-uni/types/index.uts'
import { AmPickerChangeInfo } from '@/uni_modules/antdv-next-uni/types/picker.uts'

const single : AmOption[][] = [[
	{ label: '周一', value: 'mon' },
	{ label: '周二', value: 'tue' },
	{ label: '周三', value: 'wed' },
	{ label: '周四', value: 'thu', disabled: true },
	{ label: '周五', value: 'fri' }
]]
const double : AmOption[][] = [
	[
		{ label: '上午', value: 'am' },
		{ label: '下午', value: 'pm' }
	],
	[
		{ label: '1 节', value: 1 },
		{ label: '2 节', value: 2 },
		{ label: '3 节', value: 3 },
		{ label: '4 节', value: 4 }
	]
]

const day = ref<any[]>(['tue'])
const lesson = ref<any[]>(['pm', 3])
const log = ref('')
const loading = ref(true)

function onChange(value : any[], info : AmPickerChangeInfo) {
	log.value = 'change: ' + JSON.stringify(value) + '，第 ' + info.columnIndex + ' 列'
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-picker-view v-model:value="day" :columns="single" />
			<text class="demo__hint">当前值：{{ JSON.stringify(day) }}（周四禁用）</text>
		</view>

		<text class="demo__title">多列与 change 事件</text>
		<view class="demo__card">
			<am-picker-view v-model:value="lesson" :columns="double" @change="onChange" />
			<text class="demo__hint">当前值：{{ JSON.stringify(lesson) }}</text>
			<text class="demo__hint">{{ log }}</text>
		</view>

		<text class="demo__title">高度与可见个数</text>
		<view class="demo__card">
			<am-picker-view v-model:value="day" :columns="single" :item-height="36" :visible-item-count="3" />
		</view>

		<text class="demo__title">加载中</text>
		<view class="demo__card">
			<am-picker-view :columns="single" :loading="loading" :visible-item-count="3" />
			<am-button class="demo__top" block :text="loading ? '加载完成' : '重新加载'" @click="loading = !loading" />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__top { margin-top: 12px; }
.demo__footer { height: 40px; }
</style>

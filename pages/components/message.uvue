<script setup lang="uts">
import { amMessage, amToast } from '@/uni_modules/antdv-next-uni/utils/message.uts'

// amMessage 的时长单位是秒（同 PC 的 message），amToast 是毫秒（同移动端库的 Toast）
function loadThenSuccess() {
	amMessage.loading('提交中...')
	setTimeout(() => {
		amMessage.success('提交成功')
	}, 1500)
}

function toastLoading() {
	amToast.loading('加载中')
	setTimeout(() => {
		amToast.clear()
	}, 1500)
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">message（时长单位：秒）</text>
		<view class="demo__card">
			<am-button class="demo__block" block text="success" @click="amMessage.success('已保存')" />
			<am-button class="demo__block" block text="error" @click="amMessage.error('保存失败')" />
			<am-button class="demo__block" block text="info" @click="amMessage.info('这是一条提示')" />
			<am-button class="demo__block" block text="warning，显示 5 秒" @click="amMessage.warning('库存不足', 5)" />
			<am-button class="demo__block" block text="loading → success" @click="loadThenSuccess" />
			<am-button block text="destroy" @click="amMessage.destroy()" />
		</view>

		<text class="demo__title">Toast（时长单位：毫秒）</text>
		<view class="demo__card">
			<am-button class="demo__block" block text="show" @click="amToast.show('已复制到剪贴板')" />
			<am-button class="demo__block" block text="success" @click="amToast.success('支付成功')" />
			<am-button class="demo__block" block text="fail，显示 3000 毫秒" @click="amToast.fail('网络异常', 3000)" />
			<am-button class="demo__block" block text="loading（1.5 秒后 clear）" @click="toastLoading" />
			<am-button block text="clear" @click="amToast.clear()" />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__panel { padding: 16px; }
.demo__panel-text { font-size: 16px; line-height: 24px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__panel-footer { padding: 8px 16px; }
.demo__footer { height: 40px; }
</style>

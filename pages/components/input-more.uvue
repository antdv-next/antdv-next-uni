<script setup lang="uts">
const note = ref('')
const counted = ref('自动增高的多行输入')
const keyword = ref('')
const history = ref('')
const password = ref('')
const visible = ref(false)
const searchRef = ref<AmInputSearchComponentPublicInstance | null>(null)

function onSearch(value : string, source : string) {
	history.value = 'search：“' + value + '”（来源 ' + source + '）'
}

function onCancel() {
	history.value = 'cancel'
}

function focusSearch() {
	searchRef.value?.focus()
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">多行输入 am-textarea</text>
		<view class="demo__card">
			<am-textarea class="demo__block" v-model:value="note" placeholder="固定 2 行（rows 默认 2）" />
			<am-textarea class="demo__block" v-model:value="counted" placeholder="随内容变高" auto-size :maxlength="100" show-count allow-clear />
			<am-textarea class="demo__block" v-model:value="note" variant="filled" :rows="3" placeholder="filled，3 行" />
			<am-textarea class="demo__block" v-model:value="note" variant="underlined" placeholder="underlined" />
			<am-textarea class="demo__block" v-model:value="note" status="error" placeholder="error" />
			<am-textarea value="禁用的内容" disabled />
			<text class="demo__hint">当前值：{{ note }}</text>
		</view>

		<text class="demo__title">搜索框 am-input-search</text>
		<view class="demo__card">
			<am-input-search class="demo__block" ref="searchRef" v-model:value="keyword" @search="onSearch" />
			<am-input-search class="demo__block" v-model:value="keyword" show-cancel placeholder="聚焦或有内容时显示“取消”" @search="onSearch" @cancel="onCancel" />
			<am-input-search class="demo__block" v-model:value="keyword" enter-button="搜索" :round="false" variant="outlined" @search="onSearch" />
			<am-input-search class="demo__block" v-model:value="keyword" enter-button="search" loading placeholder="loading" />
			<am-input-search class="demo__block" v-model:value="keyword" size="small" prefix="filter" placeholder="small，换了前缀图标" />
			<am-button block text="focus()" @click="focusSearch" />
			<text class="demo__hint">关键字：{{ keyword }}　{{ history }}</text>
		</view>

		<text class="demo__title">密码框 am-input-password</text>
		<view class="demo__card">
			<am-input-password class="demo__block" v-model:value="password" placeholder="请输入密码" prefix="lock" />
			<am-input-password class="demo__block" v-model:value="password" v-model:icon-visible="visible" placeholder="v-model:iconVisible" allow-clear />
			<am-input-password class="demo__block" v-model:value="password" :visibility-toggle="false" placeholder="没有切换按钮" />
			<am-input-password v-model:value="password" variant="filled" placeholder="filled" />
			<text class="demo__hint">iconVisible：{{ visible }}</text>
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.demo__label { width: 96px; font-size: 14px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__footer { height: 40px; }
</style>

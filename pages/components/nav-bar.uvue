<script setup lang="uts">
const log = ref('')

function onBack() {
	log.value = '点击了返回（' + Date.now() % 10000 + '）'
}

function leave() {
	uni.navigateBack({})
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<am-nav-bar title="标题" @back="onBack" />
		<text class="demo__hint">{{ log.length > 0 ? log : 'back 事件只负责通知，返回由页面自己调用 uni.navigateBack()' }}</text>

		<text class="demo__title">返回文字与右侧内容</text>
		<am-nav-bar title="订单详情" back="返回" right="完成" @back="leave" />

		<text class="demo__title">副标题</text>
		<am-nav-bar title="张三" sub-title="对方正在输入…" @back="onBack" />

		<text class="demo__title">不显示返回</text>
		<am-nav-bar title="首页" back-icon="" />

		<text class="demo__title">自定义两侧（插槽）</text>
		<am-nav-bar title="商品" back-icon="close" :bordered="false" @back="onBack">
			<template #left>
				<am-icon name="home" :size="20" />
			</template>
			<template #right>
				<am-icon class="demo__icon" name="search" :size="20" />
				<am-icon name="more" :size="20" />
			</template>
		</am-nav-bar>

		<text class="demo__title">自定义标题（默认插槽）</text>
		<am-nav-bar @back="onBack">
			<view class="demo__search">
				<am-icon name="search" :size="14" />
				<text class="demo__search-text">搜索商品</text>
			</view>
		</am-nav-bar>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>


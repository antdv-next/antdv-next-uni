<script setup lang="uts">
import { AmThemeConfig, setAmTheme } from '@/uni_modules/antdv-next-uni/theme/theme.uts'
import { enUS, setAmLocale, zhCN } from '@/uni_modules/antdv-next-uni/locale/locale.uts'

// 全局主题：setAmTheme 之后，所有页面的 <am-config-provider> 一起变
type Swatch = {
	name : string
	color : string
}

const swatches : Swatch[] = [
	{ name: '拂晓蓝', color: '#1677ff' },
	{ name: '极光绿', color: '#00b96b' },
	{ name: '酱紫', color: '#722ed1' },
	{ name: '火山橙', color: '#fa541c' },
	{ name: '法式洋红', color: '#eb2f96' }
]

const primary = ref('#1677ff')
const dark = ref(false)
const compact = ref(false)
const radius = ref(8)
const english = ref(false)
const size = ref('middle')
const disabled = ref(false)
const open = ref(false)

function apply() {
	const algorithm : string[] = [dark.value ? 'dark' : 'default']
	if (compact.value) algorithm.push('compact')
	const config : AmThemeConfig = {
		algorithm: algorithm,
		token: { colorPrimary: primary.value, borderRadius: radius.value }
	}
	setAmTheme(config)
}

function pick(color : string) {
	primary.value = color
	apply()
}

function toggleDark() {
	dark.value = !dark.value
	apply()
}

function toggleCompact() {
	compact.value = !compact.value
	apply()
}

function setRadius(value : number) {
	radius.value = value
	apply()
}

function toggleLocale() {
	english.value = !english.value
	setAmLocale(english.value ? enUS : zhCN)
}

// 局部主题：只影响这个 provider 里面的组件
const purple : AmThemeConfig = { token: { colorPrimary: '#722ed1', borderRadius: 20 } }
</script>

<template>
	<am-config-provider>
		<text class="demo__title">主色</text>
		<view class="demo__card demo__row">
			<view v-for="swatch in swatches" :key="swatch.color" class="demo__swatch" @click="pick(swatch.color)">
				<view :class="['demo__dot', primary == swatch.color ? 'demo__dot--active' : '']" :style="'background-color:' + swatch.color + ';'"></view>
				<text class="demo__name">{{ swatch.name }}</text>
			</view>
		</view>

		<text class="demo__title">算法与圆角</text>
		<view class="demo__card">
			<view class="demo__row">
				<am-button class="demo__item" :type="dark ? 'primary' : 'default'" text="暗色" @click="toggleDark" />
				<am-button class="demo__item" :type="compact ? 'primary' : 'default'" text="紧凑" @click="toggleCompact" />
			</view>
			<view class="demo__row">
				<am-button class="demo__item" :type="radius == 2 ? 'primary' : 'default'" text="直角" @click="setRadius(2)" />
				<am-button class="demo__item" :type="radius == 8 ? 'primary' : 'default'" text="默认" @click="setRadius(8)" />
				<am-button class="demo__item" :type="radius == 16 ? 'primary' : 'default'" text="圆润" @click="setRadius(16)" />
			</view>
		</view>

		<text class="demo__title">预览</text>
		<view class="demo__card">
			<view class="demo__row">
				<am-button class="demo__item" type="primary" text="主按钮" />
				<am-button class="demo__item" color="primary" variant="filled" text="浅色按钮" />
				<am-button class="demo__item" color="primary" variant="outlined" text="描边按钮" />
			</view>
			<am-input class="demo__block" placeholder="请输入内容" allow-clear />
			<am-button block text="打开弹出层" @click="open = true" />
		</view>

		<text class="demo__title">局部主题（嵌套）</text>
		<view class="demo__card">
			<am-button class="demo__block" type="primary" block text="外层：全局主题" />
			<am-config-provider :theme="purple">
				<am-button type="primary" block text="内层：紫色 + 大圆角" />
			</am-config-provider>
		</view>

		<text class="demo__title">尺寸与禁用</text>
		<view class="demo__card">
			<view class="demo__row">
				<am-button class="demo__item" size="small" :type="size == 'small' ? 'primary' : 'default'" text="small" @click="size = 'small'" />
				<am-button class="demo__item" size="small" :type="size == 'middle' ? 'primary' : 'default'" text="middle" @click="size = 'middle'" />
				<am-button class="demo__item" size="small" :type="size == 'large' ? 'primary' : 'default'" text="large" @click="size = 'large'" />
				<am-button class="demo__item" size="small" :type="disabled ? 'primary' : 'default'" text="禁用" @click="disabled = !disabled" />
			</view>
			<am-config-provider :component-size="size" :component-disabled="disabled">
				<am-input class="demo__block" placeholder="跟随 componentSize" />
				<view class="demo__row">
					<am-button class="demo__item" type="primary" text="按钮" />
					<am-button class="demo__item" text="按钮" />
				</view>
			</am-config-provider>
		</view>

		<text class="demo__title">国际化</text>
		<view class="demo__card">
			<am-button block :text="english ? 'English（点击切换）' : '简体中文（点击切换）'" @click="toggleLocale" />
		</view>
		<view class="demo__footer"></view>

		<am-popup v-model:open="open" round closable>
			<view class="demo__panel"><text class="demo__panel-text">弹出层跟随当前主题</text></view>
		</am-popup>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.demo__item { margin-right: 8px; margin-bottom: 10px; }
.demo__block { margin-bottom: 12px; }
.demo__swatch { align-items: center; margin-right: 14px; }
.demo__dot { width: 32px; height: 32px; border-radius: 16px; border-width: 2px; border-style: solid; border-color: transparent; }
.demo__dot--active { border-color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__name { margin-top: 4px; font-size: 11px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__panel { padding: 40px 24px; }
.demo__panel-text { font-size: 16px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); text-align: center; }
.demo__footer { height: 40px; }
</style>

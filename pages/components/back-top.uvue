<script setup lang="uts">
const rows : number[] = []
for (let i = 1; i <= 40; i++) rows.push(i)
const clicks = ref(0)
const kinds : string[] = ['默认', '主按钮 + 文字', '方形 + 自定义图标']
const kind = ref('默认')
</script>

<template>
	<am-config-provider>
		<text class="demo__title">往下滚过 400px 后右下角出现按钮（点击了 {{ clicks }} 次）</text>
		<view class="demo__card">
			<view class="demo__row">
				<am-button v-for="item in kinds" :key="item" class="demo__item" size="small" :type="kind == item ? 'primary' : 'default'" :text="item" @click="kind = item" />
			</view>
		</view>
		<view class="demo__list">
			<view v-for="n in rows" :key="n" class="demo__line">
				<text class="demo__text">第 {{ n }} 行</text>
			</view>
		</view>
		<view class="demo__footer"></view>

		<am-back-top v-if="kind == '默认'" @click="clicks++" />
		<am-back-top v-if="kind == '主按钮 + 文字'" type="primary" content="顶部" :visibility-height="200" :duration="200" @click="clicks++" />
		<am-back-top v-if="kind == '方形 + 自定义图标'" shape="square" :visibility-height="200" @click="clicks++">
			<template #icon>
				<am-icon name="home" :size="20" />
			</template>
		</am-back-top>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
	overflow: visible;
}
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; overflow: visible; }
.demo__item { margin-right: 12px; margin-bottom: 10px; }
.demo__text { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__hint { padding-top: 8px; font-size: 12px; line-height: 18px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__footer { height: 40px; }
.demo__list { margin: 12px 12px 0 12px; border-radius: 12px; background-color: var(--am-color-bg-container, #ffffff); }
.demo__line { height: 48px; padding: 0 16px; justify-content: center; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: var(--am-color-split, rgba(0, 0, 0, 0.06)); }
</style>

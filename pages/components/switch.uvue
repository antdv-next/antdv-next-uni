<script setup lang="uts">
const basic = ref(true)
const labeled = ref(false)
const small = ref(true)
const viaValue = ref(false)
const pending = ref(false)
const confirmed = ref(false)
const log = ref('')

function onChange(checked : boolean) {
	log.value = 'change：' + checked
}

// 切换前先等“请求”回来：不用 v-model，自己在 change 里决定要不要改值
function onAsyncChange(checked : boolean) {
	pending.value = true
	setTimeout(() => {
		pending.value = false
		confirmed.value = checked
	}, 800)
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-switch v-model:checked="basic" @change="onChange" />
			<text class="demo__hint">checked：{{ basic }}　{{ log }}</text>
		</view>

		<text class="demo__title">文字</text>
		<view class="demo__card">
			<am-switch class="demo__block" v-model:checked="labeled" checked-children="开" un-checked-children="关" />
			<am-switch v-model:checked="labeled" checked-children="已开启" un-checked-children="已关闭" />
		</view>

		<text class="demo__title">尺寸</text>
		<view class="demo__card">
			<am-switch class="demo__block" v-model:checked="small" />
			<am-switch v-model:checked="small" size="small" />
		</view>

		<text class="demo__title">v-model:value（checked 的别名）</text>
		<view class="demo__card">
			<am-switch v-model:value="viaValue" />
			<text class="demo__hint">value：{{ viaValue }}</text>
		</view>

		<text class="demo__title">加载中与异步切换</text>
		<view class="demo__card">
			<am-switch class="demo__block" :checked="true" loading />
			<am-switch :checked="confirmed" :loading="pending" @change="onAsyncChange" />
			<text class="demo__hint">点击后 0.8 秒才切换：{{ confirmed }}</text>
		</view>

		<text class="demo__title">禁用</text>
		<view class="demo__card">
			<am-switch class="demo__block" :checked="true" disabled />
			<am-switch disabled />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.demo__label { width: 96px; font-size: 14px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__footer { height: 40px; }
</style>

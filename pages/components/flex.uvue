<script setup lang="uts">
const justifies : string[] = ['flex-start', 'center', 'flex-end', 'space-between', 'space-around']
const aligns : string[] = ['flex-start', 'center', 'flex-end']
const justify = ref('flex-start')
const align = ref('center')
const blocks : number[] = [1, 2, 3, 4, 5, 6, 7, 8]
</script>

<template>
	<am-config-provider>
		<text class="demo__title">水平与垂直</text>
		<view class="demo__card">
			<am-flex>
				<view class="demo__block demo__block--gap"><text class="demo__block-text">1</text></view>
				<view class="demo__block demo__block--gap"><text class="demo__block-text">2</text></view>
				<view class="demo__block"><text class="demo__block-text">3</text></view>
			</am-flex>
			<am-flex vertical root-class="demo__space">
				<view class="demo__bar demo__bar--gap"><text class="demo__block-text">1</text></view>
				<view class="demo__bar demo__bar--gap"><text class="demo__block-text">2</text></view>
				<view class="demo__bar"><text class="demo__block-text">3</text></view>
			</am-flex>
		</view>

		<text class="demo__title">对齐（justify / align）</text>
		<view class="demo__card">
			<view class="demo__row">
				<am-button v-for="item in justifies" :key="item" class="demo__item" size="small" :type="justify == item ? 'primary' : 'default'" :text="item" @click="justify = item" />
			</view>
			<view class="demo__row">
				<am-button v-for="item in aligns" :key="item" class="demo__item" size="small" :type="align == item ? 'primary' : 'default'" :text="item" @click="align = item" />
			</view>
			<am-flex :justify="justify" :align="align" root-class="demo__stage">
				<view class="demo__block"><text class="demo__block-text">1</text></view>
				<view class="demo__block demo__block--tall"><text class="demo__block-text">2</text></view>
				<view class="demo__block"><text class="demo__block-text">3</text></view>
			</am-flex>
		</view>

		<text class="demo__title">换行（wrap）</text>
		<view class="demo__card">
			<am-flex wrap>
				<view v-for="n in blocks" :key="n" class="demo__block demo__block--wrap"><text class="demo__block-text">{{ n }}</text></view>
			</am-flex>
		</view>

		<text class="demo__title">占满剩余空间（flex）</text>
		<view class="demo__card">
			<am-flex align="center">
				<view class="demo__block demo__block--gap"><text class="demo__block-text">固定</text></view>
				<am-flex flex="1" justify="center" root-class="demo__fill">
					<text class="demo__block-text">flex="1"</text>
				</am-flex>
			</am-flex>
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>


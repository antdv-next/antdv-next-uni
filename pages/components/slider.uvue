<script setup lang="uts">
const basic = ref<any | null>(30)
const stepped = ref<any | null>(40)
const ranged = ref<any | null>([20, 60])
const log = ref('')

function text(value : any | null) : string {
	return JSON.stringify(value) ?? 'null'
}

function onChangeComplete(value : any | null) {
	log.value = 'changeComplete：' + text(value)
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-slider v-model:value="basic" @changeComplete="onChangeComplete" />
			<text class="demo__hint">value：{{ text(basic) }}（拖动中就更新）　{{ log }}</text>
		</view>

		<text class="demo__title">范围、步长与显示当前值</text>
		<view class="demo__card">
			<am-slider v-model:value="stepped" :min="0" :max="200" :step="20" show-value />
			<text class="demo__hint">0 ~ 200，步长 20</text>
		</view>

		<text class="demo__title">双滑块（range）：上面调小的值，下面调大的值</text>
		<view class="demo__card">
			<am-slider v-model:value="ranged" range show-value />
			<text class="demo__hint">value：{{ text(ranged) }}</text>
		</view>

		<text class="demo__title">禁用</text>
		<view class="demo__card">
			<am-slider :value="50" disabled />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.demo__label { width: 96px; font-size: 14px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__footer { height: 40px; }
</style>

.demo__footer { height: 40px; }
.demo__wrap { margin: 0 12px; }
.demo__heading { font-size: 16px; font-weight: bold; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__heading--gap { margin-left: 6px; }
.demo__desc { margin-top: 4px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__action { flex: 1; height: 44px; align-items: center; justify-content: center; }
.demo__button { margin-top: 12px; }

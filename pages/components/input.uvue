<script setup lang="uts">
// easycom 组件的实例类型是自动生成的全局类型：组件名的驼峰 + ComponentPublicInstance，不需要 import
const basic = ref('')
const clearable = ref('可以清除的内容')
const counted = ref('')
const password = ref('')
const amount = ref('')
const inputRef = ref<AmInputComponentPublicInstance | null>(null)
const methodValue = ref('')

function focusInput() {
	inputRef.value?.focus()
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-input v-model:value="basic" placeholder="请输入内容" />
			<text class="demo__hint">当前值：{{ basic }}</text>
		</view>

		<text class="demo__title">清除、计数与密码</text>
		<view class="demo__card">
			<am-input class="demo__block" v-model:value="clearable" placeholder="带清除按钮" allow-clear />
			<am-input class="demo__block" v-model:value="counted" placeholder="最多 20 个字" :maxlength="20" show-count />
			<am-input v-model:value="password" type="password" placeholder="请输入密码" prefix="lock" />
		</view>

		<text class="demo__title">前缀与后缀</text>
		<view class="demo__card">
			<am-input class="demo__block" v-model:value="basic" placeholder="搜索" prefix="search" allow-clear />
			<am-input v-model:value="amount" type="digit" placeholder="0.00" prefix="¥" suffix="元" align="end" />
		</view>

		<text class="demo__title">变体</text>
		<view class="demo__card">
			<am-input class="demo__block" v-model:value="basic" placeholder="outlined" />
			<am-input class="demo__block" v-model:value="basic" variant="filled" placeholder="filled" />
			<am-input class="demo__block" v-model:value="basic" variant="underlined" placeholder="underlined" />
			<am-input v-model:value="basic" variant="borderless" placeholder="borderless" />
		</view>

		<text class="demo__title">尺寸</text>
		<view class="demo__card">
			<am-input class="demo__block" v-model:value="basic" size="large" placeholder="large" />
			<am-input class="demo__block" v-model:value="basic" placeholder="middle" />
			<am-input v-model:value="basic" size="small" placeholder="small" />
		</view>

		<text class="demo__title">状态</text>
		<view class="demo__card">
			<am-input class="demo__block" v-model:value="basic" status="error" placeholder="error" />
			<am-input class="demo__block" v-model:value="basic" status="warning" placeholder="warning" />
			<am-input class="demo__block" v-model:value="basic" disabled placeholder="disabled" />
			<am-input value="只读的内容" read-only />
		</view>

		<text class="demo__title">方法</text>
		<view class="demo__card">
			<am-input class="demo__block" ref="inputRef" v-model:value="methodValue" placeholder="点下面的按钮获得焦点" />
			<am-button type="primary" block text="focus()" @click="focusInput" />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }

<script setup lang="uts">
import { AmOption } from '@/uni_modules/antdv-next-uni/types/index.uts'

const areas : AmOption[] = [
	{
		label: '浙江',
		value: 'zhejiang',
		children: [
			{
				label: '杭州',
				value: 'hangzhou',
				children: [
					{ label: '西湖区', value: 'xihu' },
					{ label: '余杭区', value: 'yuhang' }
				]
			},
			{ label: '宁波', value: 'ningbo', children: [{ label: '海曙区', value: 'haishu' }] }
		]
	},
	{
		label: '江苏',
		value: 'jiangsu',
		children: [
			{ label: '南京', value: 'nanjing', children: [{ label: '玄武区', value: 'xuanwu' }] },
			{ label: '苏州', value: 'suzhou', disabled: true }
		]
	}
]
// 逐级加载：isLeaf 为 false 的选项点了以后由 loadData 返回下级
const lazyRoot : AmOption[] = [
	{ label: '研发部', value: 'rd', isLeaf: false },
	{ label: '市场部', value: 'market', isLeaf: false }
]

const area = ref<any[]>([])
const partial = ref<any[]>(['zhejiang'])
const lazy = ref<any[]>([])
const rendered = ref<any[]>(['zhejiang', 'hangzhou', 'xihu'])
const log = ref('')

function onChange(value : any[], selectedOptions : AmOption[]) {
	log.value = 'change: ' + JSON.stringify(value)
}

function onSelect(option : AmOption, level : number) {
	log.value = 'select: ' + option.label + '（第 ' + level + ' 级）'
}

function loadData(selectedOptions : AmOption[]) : Promise<AmOption[]> {
	const parent = selectedOptions[selectedOptions.length - 1]
	return new Promise<AmOption[]>((resolve) => {
		setTimeout(() => {
			const list : AmOption[] = []
			for (let i = 1; i <= 3; i++) {
				// 第二级还可以往下加载，第三级是最后一级
				const option : AmOption = { label: parent.label + '-' + i, value: parent.value + '-' + i, isLeaf: selectedOptions.length >= 2 }
				list.push(option)
			}
			resolve(list)
		}, 600)
	})
}

function displayRender(labels : string[], selectedOptions : AmOption[]) : string {
	return labels.length > 0 ? labels[labels.length - 1] : ''
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-cascader v-model:value="area" :options="areas" title="选择地区" placeholder="请选择地区" allow-clear @change="onChange" @select="onSelect" />
			<text class="demo__hint">当前值：{{ JSON.stringify(area) }}</text>
			<text class="demo__hint">{{ log }}</text>
		</view>

		<text class="demo__title">可以只选到中间一级</text>
		<view class="demo__card">
			<am-cascader v-model:value="partial" :options="areas" change-on-select title="changeOnSelect" />
			<text class="demo__hint">当前值：{{ JSON.stringify(partial) }}</text>
		</view>

		<text class="demo__title">逐级加载</text>
		<view class="demo__card">
			<am-cascader v-model:value="lazy" :options="lazyRoot" :load-data="loadData" title="选择部门" placeholder="loadData" />
			<text class="demo__hint">当前值：{{ JSON.stringify(lazy) }}</text>
		</view>

		<text class="demo__title">只显示最后一级</text>
		<view class="demo__card">
			<am-cascader v-model:value="rendered" :options="areas" :display-render="displayRender" />
		</view>

		<text class="demo__title">变体与状态</text>
		<view class="demo__card">
			<am-cascader class="demo__block" v-model:value="area" :options="areas" variant="filled" />
			<am-cascader class="demo__block" v-model:value="area" :options="areas" variant="borderless" />
			<am-cascader class="demo__block" v-model:value="area" :options="areas" status="error" />
			<am-cascader v-model:value="area" :options="areas" disabled />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__panel { padding: 16px; }
.demo__panel-text { font-size: 16px; line-height: 24px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__footer { height: 40px; }
</style>

<script setup lang="uts">
import { AmTimelineItem } from '@/uni_modules/antdv-next-uni/types/timeline.uts'

const basic : AmTimelineItem[] = [
	{ content: '创建服务现场 2015-09-01' },
	{ content: '初步排除网络异常 2015-09-01' },
	{ content: '技术测试异常 2015-09-01' },
	{ content: '网络异常正在修复 2015-09-01' }
]

const colored : AmTimelineItem[] = [
	{ color: 'green', content: '创建服务现场' },
	{ color: 'red', content: '初步排除网络异常' },
	{ color: 'gray', content: '技术测试异常' },
	{ color: '#722ed1', content: '自定义颜色' },
	{ icon: 'clock', color: 'red', content: '自定义图标' },
	{ loading: true, content: '加载中的节点' }
]

const titled : AmTimelineItem[] = [
	{ title: '09:00', content: '已下单' },
	{ title: '10:30', content: '商家已发货', color: 'green' },
	{ title: '次日 08:12', content: '快件到达【杭州转运中心】，正在分拣' },
	{ title: '次日 14:00', content: '派送中' }
]

const reverse = ref(false)
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-timeline :items="basic" />
		</view>

		<text class="demo__title">颜色、图标与加载中</text>
		<view class="demo__card">
			<am-timeline :items="colored" />
		</view>

		<text class="demo__title">实心圆点（variant="filled"）</text>
		<view class="demo__card">
			<am-timeline :items="basic" variant="filled" />
		</view>

		<text class="demo__title">标题在对侧（title）</text>
		<view class="demo__card">
			<am-timeline :items="titled" title-span="6" />
		</view>

		<text class="demo__title">交替展示（mode="alternate"）</text>
		<view class="demo__card">
			<am-timeline :items="titled" mode="alternate" />
		</view>

		<text class="demo__title">内容在轴的另一侧（mode="end"）</text>
		<view class="demo__card">
			<am-timeline :items="basic" mode="end" />
		</view>

		<text class="demo__title">最后一个进行中的节点与倒序</text>
		<view class="demo__card">
			<am-timeline :items="basic" pending="记录中..." :reverse="reverse" />
			<am-button size="small" :text="reverse ? '正序' : '倒序'" @click="reverse = !reverse" />
		</view>

		<text class="demo__title">自定义内容（contentRender 插槽）</text>
		<view class="demo__card">
			<am-timeline :items="titled">
				<template #contentRender="{ item, index }">
					<text class="demo__text">{{ (index as number) + 1 }}. {{ (item as AmTimelineItem).content }}</text>
					<text class="demo__hint">{{ (item as AmTimelineItem).title }}</text>
				</template>
			</am-timeline>
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.demo__item { margin-right: 12px; margin-bottom: 10px; }
.demo__block { margin-bottom: 12px; }
.demo__text { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__hint { margin-top: 8px; font-size: 12px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__footer { height: 40px; }
</style>

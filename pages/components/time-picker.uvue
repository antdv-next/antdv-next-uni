<script setup lang="uts">
// 值是字符串（valueFormat 的格式，默认同 format）
const time = ref('')
const short = ref('09:30')
const stepped = ref('')
const custom = ref('')
const open = ref(false)
const log = ref('')

function onChange(value : string, text : string) {
	log.value = 'change: ' + value
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-time-picker v-model:value="time" title="选择时间" allow-clear @change="onChange" />
			<text class="demo__hint">当前值：{{ time }}</text>
			<text class="demo__hint">{{ log }}</text>
		</view>

		<text class="demo__title">时分</text>
		<view class="demo__card">
			<am-time-picker v-model:value="short" format="HH:mm" />
			<text class="demo__hint">当前值：{{ short }}</text>
		</view>

		<text class="demo__title">步长与默认时间</text>
		<view class="demo__card">
			<am-time-picker v-model:value="stepped" format="HH:mm" :minute-step="15" default-open-value="08:00" placeholder="15 分钟一档，默认 08:00" />
			<text class="demo__hint">当前值：{{ stepped }}</text>
		</view>

		<text class="demo__title">变体与状态</text>
		<view class="demo__card">
			<am-time-picker class="demo__block" v-model:value="time" variant="filled" />
			<am-time-picker class="demo__block" v-model:value="time" variant="borderless" />
			<am-time-picker class="demo__block" v-model:value="time" status="warning" />
			<am-time-picker v-model:value="time" disabled />
		</view>

		<text class="demo__title">不用触发区</text>
		<view class="demo__card">
			<am-button block :text="custom.length > 0 ? custom : '选择时间'" @click="open = true" />
			<am-time-picker v-model:value="custom" v-model:open="open" :trigger="false" format="HH:mm" />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__panel { padding: 16px; }
.demo__panel-text { font-size: 16px; line-height: 24px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__footer { height: 40px; }
</style>

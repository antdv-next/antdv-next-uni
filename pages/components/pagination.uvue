<script setup lang="uts">
const current = ref(1)
const many = ref(6)
const simple = ref(2)
const log = ref('')

function onChange(page : number, pageSize : number) {
	log.value = 'change: 第 ' + page + ' 页，每页 ' + pageSize + ' 条'
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-pagination v-model:current="current" :total="50" @change="onChange" />
			<text class="demo__hint">current = {{ current }}　{{ log }}</text>
		</view>

		<text class="demo__title">页数较多时折叠</text>
		<view class="demo__card">
			<am-pagination v-model:current="many" :total="500" show-less-items />
		</view>

		<text class="demo__title">简洁模式</text>
		<view class="demo__card">
			<am-pagination v-model:current="simple" :total="85" simple />
			<am-pagination class="demo__gap" v-model:current="simple" :total="85" simple prev-icon="left" next-icon="right" />
		</view>

		<text class="demo__title">显示总数（showTotal 插槽）</text>
		<view class="demo__card">
			<am-pagination v-model:current="current" :total="50">
				<template #showTotal="{ total, range }">
					<text class="demo__total">第 {{ range[0] }}-{{ range[1] }} 条 / 共 {{ total }} 条</text>
				</template>
			</am-pagination>
		</view>

		<text class="demo__title">尺寸、非受控、禁用</text>
		<view class="demo__card">
			<am-pagination :total="50" :default-current="2" size="small" />
			<am-pagination class="demo__gap" :total="50" :default-current="3" size="large" />
			<am-pagination class="demo__gap" :total="50" disabled />
		</view>

		<text class="demo__title">只有一页时隐藏</text>
		<view class="demo__card">
			<am-pagination :total="8" hide-on-single-page />
			<text class="demo__hint">total = 8、hideOnSinglePage：上面什么都不显示</text>
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card { margin: 0 12px; padding: 16px 8px; background-color: var(--am-color-bg-container, #ffffff); border-radius: 12px; }
.demo__hint { margin-top: 12px; padding: 0 8px; font-size: 12px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__gap { margin-top: 12px; }
.demo__total { margin-right: 8px; font-size: 12px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__footer { height: 40px; }
</style>

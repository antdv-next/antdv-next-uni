.demo__item { margin-right: 12px; margin-bottom: 10px; }
.demo__text { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__hint { padding-top: 8px; font-size: 12px; line-height: 18px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__footer { height: 40px; }
.demo__stage { margin-bottom: 8px; padding: 8px; background-color: var(--am-color-fill-tertiary, rgba(0, 0, 0, 0.04)); border-radius: 8px; }
.demo__tall { width: 40px; height: 64px; align-items: center; justify-content: center; background-color: var(--am-color-primary, #1677ff); border-radius: 6px; }
.demo__block { width: 64px; height: 40px; align-items: center; justify-content: center; background-color: var(--am-color-primary, #1677ff); border-radius: 6px; }
.demo__bar { height: 32px; align-items: center; justify-content: center; background-color: var(--am-color-primary, #1677ff); border-radius: 6px; }
.demo__block-text { font-size: 14px; color: #ffffff; }
.demo__gap-top { margin-top: 12px; }

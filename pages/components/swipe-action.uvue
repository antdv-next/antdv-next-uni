<script setup lang="uts">
import { AmSwipeActionItem } from '@/uni_modules/antdv-next-uni/types/swipe-action.uts'

const right : AmSwipeActionItem[] = [
	{ key: 'top', text: '置顶', color: 'primary' },
	{ key: 'mute', text: '免打扰', color: 'warning' },
	{ key: 'delete', text: '删除', color: 'danger' }
]
const left : AmSwipeActionItem[] = [
	{ key: 'read', text: '已读', color: 'success' },
	{ key: 'more', text: '更多' }
]
const custom : AmSwipeActionItem[] = [
	{ key: 'pin', text: '收藏', color: '#722ed1' }
]

const log = ref('左滑或右滑下面的单元格')
const rowRef = ref<AmSwipeActionComponentPublicInstance | null>(null)

function onAction(action : AmSwipeActionItem) {
	log.value = 'action: ' + action.key
}

function onReveal(side : string) {
	log.value = 'actionsReveal: ' + side
}

function onClose() {
	log.value = 'close'
}

function showRight() {
	rowRef.value?.show('right')
}

function closeRow() {
	rowRef.value?.close()
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">{{ log }}</text>
		<am-swipe-action :right-actions="right" @action="onAction" @actions-reveal="onReveal" @close="onClose">
			<am-list-item title="左滑露出右侧的按钮" description="置顶、免打扰、删除" />
		</am-swipe-action>
		<am-swipe-action :left-actions="left" :right-actions="right" @action="onAction" @actions-reveal="onReveal" @close="onClose">
			<am-list-item title="两侧都有按钮" description="右滑露出左侧的按钮" />
		</am-swipe-action>
		<am-swipe-action :right-actions="custom" :close-on-action="false" @action="onAction">
			<am-list-item title="点按钮后不收起" description="closeOnAction = false；自定义颜色" />
		</am-swipe-action>
		<am-swipe-action :right-actions="right" disabled>
			<am-list-item title="禁用" description="滑不动" />
		</am-swipe-action>

		<text class="demo__title">自定义操作区域（right 插槽）</text>
		<am-swipe-action>
			<am-list-item title="右侧是自定义内容" :bordered="false" />
			<template #right>
				<view class="demo__custom">
					<am-icon name="heart-fill" :size="20" color="#ffffff" />
				</view>
			</template>
		</am-swipe-action>

		<text class="demo__title">用方法展开 / 收起</text>
		<am-swipe-action ref="rowRef" :right-actions="right" @action="onAction">
			<am-list-item title="show('right') / close()" :bordered="false" />
		</am-swipe-action>
		<view class="demo__card demo__row">
			<am-button class="demo__item" type="primary" text="展开右侧" @click="showRight" />
			<am-button class="demo__item" text="收起" @click="closeRow" />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card { margin: 12px 12px 0 12px; padding: 16px 16px 6px 16px; background-color: var(--am-color-bg-container, #ffffff); border-radius: 12px; }
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.demo__item { margin-right: 8px; margin-bottom: 10px; }
.demo__custom { width: 72px; flex: 1; align-items: center; justify-content: center; background-color: #eb2f96; }
.demo__footer { height: 40px; }
</style>

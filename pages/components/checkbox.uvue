<script setup lang="uts">
import { AmOption } from '@/uni_modules/antdv-next-uni/types/index.uts'

const agree = ref(false)
const round = ref(true)
const fruits = ref<any[]>(['apple'])
const limited = ref<any[]>(['a'])
const rows = ref<any[]>(['wifi'])
const custom = ref<any[]>(['x'])
const changed = ref('')

const fruitOptions : AmOption[] = [
	{ label: '苹果', value: 'apple' },
	{ label: '香蕉', value: 'banana' },
	{ label: '橙子', value: 'orange' },
	{ label: '榴莲（不可选）', value: 'durian', disabled: true }
]
const letters : AmOption[] = [{ label: 'A', value: 'a' }, { label: 'B', value: 'b' }, { label: 'C', value: 'c' }, { label: 'D', value: 'd' }]
const services : AmOption[] = [{ label: '无线网络', value: 'wifi' }, { label: '停车位', value: 'parking' }, { label: '早餐', value: 'breakfast' }]

// 全选 / 半选
const allChecked = computed(() : boolean => fruits.value.length == 3)
const indeterminate = computed(() : boolean => fruits.value.length > 0 && fruits.value.length < 3)

function toggleAll(checked : boolean) {
	fruits.value = checked ? ['apple', 'banana', 'orange'] : []
}

function onChange(values : any[]) {
	changed.value = 'change：' + (JSON.stringify(values) ?? '')
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-checkbox v-model:checked="agree" label="已阅读并同意协议" />
			<am-checkbox :checked="true" disabled label="选中且禁用" />
			<am-checkbox disabled label="禁用" />
			<text class="demo__hint">checked：{{ agree }}</text>
		</view>

		<text class="demo__title">形状与图标</text>
		<view class="demo__card">
			<am-checkbox v-model:checked="round" shape="round" label="shape=round" />
			<am-checkbox v-model:checked="round" shape="round" icon="heart-fill" label="icon=heart-fill" />
		</view>

		<text class="demo__title">多选组（options）与全选</text>
		<view class="demo__card">
			<am-checkbox :checked="allChecked" :indeterminate="indeterminate" label="全选" @change="toggleAll" />
			<am-checkbox-group v-model:value="fruits" :options="fruitOptions" @change="onChange" />
			<text class="demo__hint">value：{{ JSON.stringify(fruits) }}</text>
			<text class="demo__hint">{{ changed }}</text>
		</view>

		<text class="demo__title">最多选 2 项（max）</text>
		<view class="demo__card">
			<am-checkbox-group v-model:value="limited" :options="letters" :max="2" />
		</view>

		<text class="demo__title">列表式（block）</text>
		<view class="demo__card">
			<am-checkbox-group v-model:value="rows" :options="services" block shape="round" />
		</view>

		<text class="demo__title">组里直接放 am-checkbox</text>
		<view class="demo__card">
			<am-checkbox-group v-model:value="custom">
				<am-checkbox value="x" label="选项 X" />
				<am-checkbox value="y" label="选项 Y" />
				<am-checkbox value="z" label="选项 Z" disabled />
			</am-checkbox-group>
			<text class="demo__hint">value：{{ JSON.stringify(custom) }}</text>
		</view>

		<text class="demo__title">禁用整组</text>
		<view class="demo__card">
			<am-checkbox-group :value="fruits" :options="fruitOptions" disabled />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.demo__label { width: 96px; font-size: 14px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__footer { height: 40px; }
</style>

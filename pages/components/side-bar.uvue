<script setup lang="uts">
import { AmSideBarItem } from '@/uni_modules/antdv-next-uni/types/side-bar.uts'

const items : AmSideBarItem[] = [
	{ key: 'hot', title: '热门推荐' },
	{ key: 'phone', title: '手机数码', badge: 5 },
	{ key: 'home', title: '家用电器', badge: true },
	{ key: 'food', title: '食品生鲜' },
	{ key: 'beauty', title: '美妆个护', disabled: true },
	{ key: 'sport', title: '运动户外' },
	{ key: 'book', title: '图书文娱', badge: '新' },
	{ key: 'baby', title: '母婴用品' },
	{ key: 'car', title: '汽车用品' },
	{ key: 'pet', title: '宠物生活' }
]
const short : AmSideBarItem[] = [
	{ key: 'a', title: '选项一' },
	{ key: 'b', title: '选项二' },
	{ key: 'c', title: '选项三' }
]

const active = ref('phone')
const log = ref('')

function titleOf(key : string) : string {
	const found = items.find((item) : boolean => item.key == key)
	return found == null ? '' : (found.title ?? '')
}

function onChange(key : string) {
	log.value = 'change: ' + key
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法（左侧导航 + 右侧内容，项多时可以滚动）</text>
		<view class="demo__layout">
			<am-side-bar v-model:activeKey="active" :items="items" @change="onChange" />
			<view class="demo__main">
				<text class="demo__text">{{ titleOf(active) }}</text>
				<text class="demo__hint">activeKey = {{ active }}　{{ log }}</text>
			</view>
		</view>

		<text class="demo__title">非受控（defaultActiveKey）与 title 插槽</text>
		<view class="demo__layout demo__layout--short">
			<am-side-bar :items="short" default-active-key="c">
				<template #title="{ item, active }">
					<text :class="['demo__custom', active ? 'demo__custom--active' : '']">{{ active ? '● ' : '' }}{{ item.title }}</text>
				</template>
			</am-side-bar>
			<view class="demo__main">
				<text class="demo__text">最后一项选中时，它下面的角也是圆的</text>
			</view>
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
	overflow: visible;
}
.demo__row { flex-direction: row; flex-wrap: wrap; align-items: center; overflow: visible; }
.demo__item { margin-right: 12px; margin-bottom: 10px; }
.demo__text { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__hint { padding-top: 8px; font-size: 12px; line-height: 18px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__footer { height: 40px; }
.demo__layout { flex-direction: row; height: 360px; margin: 0 12px; border-radius: 12px; background-color: var(--am-color-bg-container, #ffffff); }
.demo__layout--short { height: 220px; }
.demo__main { flex: 1; padding: 16px; }
.demo__custom { font-size: 14px; line-height: 22px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__custom--active { color: var(--am-color-success, #52c41a); }
</style>

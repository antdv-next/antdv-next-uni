<script setup lang="uts">
const bottom = ref(false)
const top = ref(false)
const left = ref(false)
const right = ref(false)
const center = ref(false)
const round = ref(false)
const locked = ref(false)
const log = ref('')

function onAfterOpenChange(open : boolean) {
	log.value = 'afterOpenChange: ' + open
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">弹出位置</text>
		<view class="demo__card">
			<am-button class="demo__block" block text="底部弹出" @click="bottom = true" />
			<am-button class="demo__block" block text="顶部弹出" @click="top = true" />
			<am-button class="demo__block" block text="左侧弹出" @click="left = true" />
			<am-button class="demo__block" block text="右侧弹出" @click="right = true" />
			<am-button block text="居中弹出" @click="center = true" />
		</view>

		<text class="demo__title">圆角与关闭图标</text>
		<view class="demo__card">
			<am-button block text="圆角 + 关闭图标" @click="round = true" />
			<text class="demo__hint">{{ log }}</text>
		</view>

		<text class="demo__title">点击遮罩不关闭</text>
		<view class="demo__card">
			<am-button block text="maskClosable = false" @click="locked = true" />
		</view>
		<view class="demo__footer"></view>

		<am-popup v-model:open="bottom">
			<view class="demo__panel"><text class="demo__panel-text">底部弹出的内容</text></view>
		</am-popup>
		<am-popup v-model:open="top" placement="top">
			<view class="demo__panel"><text class="demo__panel-text">顶部弹出的内容</text></view>
		</am-popup>
		<am-popup v-model:open="left" placement="left" :width="260">
			<view class="demo__panel"><text class="demo__panel-text">左侧弹出的内容</text></view>
		</am-popup>
		<am-popup v-model:open="right" placement="right">
			<view class="demo__panel"><text class="demo__panel-text">右侧弹出的内容</text></view>
		</am-popup>
		<am-popup v-model:open="center" placement="center">
			<view class="demo__panel"><text class="demo__panel-text">居中弹出的内容</text></view>
		</am-popup>
		<am-popup v-model:open="round" round closable :height="280" @after-open-change="onAfterOpenChange">
			<view class="demo__panel"><text class="demo__panel-text">圆角弹出层</text></view>
		</am-popup>
		<am-popup v-model:open="locked" round :mask-closable="false">
			<view class="demo__panel">
				<text class="demo__panel-text">只能点按钮关闭</text>
				<am-button class="demo__close" type="primary" block text="关闭" @click="locked = false" />
			</view>
		</am-popup>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__panel { padding: 32px 24px; }
.demo__panel-text { font-size: 16px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); text-align: center; }
.demo__close { margin-top: 20px; }
.demo__footer { height: 40px; }
</style>

<script setup lang="uts">
import { AmFieldNames, AmOption } from '@/uni_modules/antdv-next-uni/types/index.uts'

const cities : AmOption[] = [
	{ label: '北京', value: 'beijing' },
	{ label: '上海', value: 'shanghai', description: '直辖市' },
	{ label: '广州', value: 'guangzhou' },
	{ label: '深圳', value: 'shenzhen' },
	{ label: '杭州', value: 'hangzhou', disabled: true },
	{ label: '成都', value: 'chengdu' },
	{ label: '武汉', value: 'wuhan' },
	{ label: '西安', value: 'xian' }
]
// 接口返回的数据：字段名不同时配合 fieldNames
const users = [
	{ id: 1, name: '张三' },
	{ id: 2, name: '李四' },
	{ id: 3, name: '王五' }
]
const userFields : AmFieldNames = { label: 'name', value: 'id' }

const city = ref<any | null>(null)
const tags = ref<any[]>(['beijing', 'shenzhen'])
const limited = ref<any[]>([])
const user = ref<any | null>(2)
const remote = ref<any | null>(null)
const remoteOptions = ref<AmOption[]>([])
const remoteLoading = ref(false)
const log = ref('')
let timer = 0

function onChange(value : any | null, option : any | null) {
	log.value = 'change: ' + JSON.stringify(value)
}

function onSelect(value : any) {
	log.value = 'select: ' + value
}

function onDeselect(value : any) {
	log.value = 'deselect: ' + value
}

// 远程搜索：filterOption 为 false，在 search 事件里换 options
function onSearch(keyword : string) {
	clearTimeout(timer)
	if (keyword.length == 0) {
		remoteOptions.value = []
		return
	}
	remoteLoading.value = true
	timer = setTimeout(() => {
		const list : AmOption[] = []
		for (let i = 1; i <= 3; i++) {
			const option : AmOption = { label: keyword + ' 的结果 ' + i, value: keyword + '-' + i }
			list.push(option)
		}
		remoteOptions.value = list
		remoteLoading.value = false
	}, 500)
}
</script>

<template>
	<am-config-provider>
		<text class="demo__title">基础用法</text>
		<view class="demo__card">
			<am-select v-model:value="city" :options="cities" title="选择城市" placeholder="请选择城市" allow-clear @change="onChange" />
			<text class="demo__hint">当前值：{{ JSON.stringify(city) }}</text>
		</view>

		<text class="demo__title">多选与搜索</text>
		<view class="demo__card">
			<am-select v-model:value="tags" :options="cities" mode="multiple" show-search title="选择城市" allow-clear @select="onSelect" @deselect="onDeselect" @change="onChange" />
			<text class="demo__hint">当前值：{{ JSON.stringify(tags) }}</text>
			<text class="demo__hint">{{ log }}</text>
		</view>

		<text class="demo__title">最多选 2 个、触发区最多显示 1 个</text>
		<view class="demo__card">
			<am-select v-model:value="limited" :options="cities" mode="multiple" :max-count="2" :max-tag-count="1" placeholder="maxCount = 2" />
		</view>

		<text class="demo__title">fieldNames</text>
		<view class="demo__card">
			<am-select v-model:value="user" :options="users" :field-names="userFields" title="选择成员" />
			<text class="demo__hint">当前值：{{ JSON.stringify(user) }}</text>
		</view>

		<text class="demo__title">远程搜索与空状态</text>
		<view class="demo__card">
			<am-select
				v-model:value="remote"
				:options="remoteOptions"
				show-search
				:filter-option="false"
				:loading="remoteLoading"
				not-found-content="输入关键字搜索"
				placeholder="输入关键字搜索"
				@search="onSearch"
			/>
		</view>

		<text class="demo__title">变体、尺寸与状态</text>
		<view class="demo__card">
			<am-select class="demo__block" v-model:value="city" :options="cities" variant="filled" />
			<am-select class="demo__block" v-model:value="city" :options="cities" variant="borderless" />
			<am-select class="demo__block" v-model:value="city" :options="cities" size="large" />
			<am-select class="demo__block" v-model:value="city" :options="cities" status="error" />
			<am-select v-model:value="city" :options="cities" disabled />
		</view>
		<view class="demo__footer"></view>
	</am-config-provider>
</template>

<style>
.demo__title { padding: 20px 16px 10px 16px; font-size: 14px; color: var(--am-color-text-tertiary, rgba(0, 0, 0, 0.45)); }
.demo__card {
	margin: 0 12px;
	padding: 16px;
	background-color: var(--am-color-bg-container, #ffffff);
	border-radius: 12px;
}
.demo__block { margin-bottom: 12px; }
.demo__hint { margin-top: 8px; font-size: 13px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.demo__panel { padding: 16px; }
.demo__panel-text { font-size: 16px; line-height: 24px; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.demo__footer { height: 40px; }
</style>

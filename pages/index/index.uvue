	title : string
	subtitle : string
	icon : string
	url : string
}

type DemoGroup = {
	title : string
	entries : DemoEntry[]
}

const groups : DemoGroup[] = [
	{
		title: '通用',
		entries: [
			{ title: 'BackTop', subtitle: '回到顶部', icon: 'appstore', url: '/pages/components/back-top' },
			{ title: 'Button', subtitle: '按钮', icon: 'appstore', url: '/pages/components/button' },
			{ title: 'ConfigProvider', subtitle: '全局化配置', icon: 'appstore', url: '/pages/components/config-provider' },
			{ title: 'FloatButton', subtitle: '悬浮按钮', icon: 'appstore', url: '/pages/components/float-button' },
			{ title: 'FloatButtonGroup', subtitle: '悬浮按钮组', icon: 'appstore', url: '/pages/components/float-button-group' },
			{ title: 'Typography', subtitle: '排版', icon: 'appstore', url: '/pages/components/typography' }
		]
	},
	{
		title: '布局',
		entries: [
			{ title: 'Divider', subtitle: '分割线', icon: 'appstore', url: '/pages/components/divider' },
			{ title: 'Flex', subtitle: '弹性布局', icon: 'appstore', url: '/pages/components/flex' },
			{ title: 'Grid', subtitle: '栅格', icon: 'appstore', url: '/pages/components/grid' },
			{ title: 'SafeArea', subtitle: '安全区', icon: 'appstore', url: '/pages/components/safe-area' },
			{ title: 'Space', subtitle: '间距', icon: 'appstore', url: '/pages/components/space' }
		]
	},
	{
		title: '导航',
		entries: [
			{ title: 'Dropdown', subtitle: '下拉菜单', icon: 'right', url: '/pages/components/dropdown' },
			{ title: 'IndexBar', subtitle: '索引栏', icon: 'right', url: '/pages/components/index-bar' },
			{ title: 'NavBar', subtitle: '导航栏', icon: 'right', url: '/pages/components/nav-bar' },
			{ title: 'Pagination', subtitle: '分页', icon: 'right', url: '/pages/components/pagination' },
			{ title: 'Segmented', subtitle: '分段控制器', icon: 'right', url: '/pages/components/segmented' },
			{ title: 'SideBar', subtitle: '侧边导航', icon: 'right', url: '/pages/components/side-bar' },
			{ title: 'Steps', subtitle: '步骤条', icon: 'right', url: '/pages/components/steps' },
			{ title: 'TabBar', subtitle: '标签栏', icon: 'right', url: '/pages/components/tab-bar' },
			{ title: 'Tabs', subtitle: '标签页', icon: 'right', url: '/pages/components/tabs' }
		]
	},
	{
		title: '数据录入',
		entries: [
			{ title: 'Calendar', subtitle: '日历', icon: 'edit', url: '/pages/components/calendar' },
			{ title: 'Cascader', subtitle: '级联选择', icon: 'edit', url: '/pages/components/cascader' },
			{ title: 'Checkbox', subtitle: '多选框', icon: 'edit', url: '/pages/components/checkbox' },
			{ title: 'DatePicker', subtitle: '日期选择器', icon: 'edit', url: '/pages/components/date-picker' },
			{ title: 'Form', subtitle: '表单', icon: 'edit', url: '/pages/components/form' },
			{ title: 'Input', subtitle: '文本域 / 搜索 / 密码', icon: 'edit', url: '/pages/components/input-more' },
			{ title: 'Input', subtitle: '输入框', icon: 'edit', url: '/pages/components/input' },
			{ title: 'InputNumber', subtitle: '数字输入框', icon: 'edit', url: '/pages/components/input-number' },
			{ title: 'InputOTP', subtitle: '一次性密码框', icon: 'edit', url: '/pages/components/input-otp' },
			{ title: 'NumberKeyboard', subtitle: '数字键盘', icon: 'edit', url: '/pages/components/number-keyboard' },
			{ title: 'Picker', subtitle: '选择器', icon: 'edit', url: '/pages/components/picker' },
			{ title: 'PickerView', subtitle: '选择器视图', icon: 'edit', url: '/pages/components/picker-view' },
			{ title: 'Radio', subtitle: '单选框', icon: 'edit', url: '/pages/components/radio' },
			{ title: 'Rate', subtitle: '评分', icon: 'edit', url: '/pages/components/rate' },
			{ title: 'Select', subtitle: '选择器', icon: 'edit', url: '/pages/components/select' },
			{ title: 'Selector', subtitle: '选择组', icon: 'edit', url: '/pages/components/selector' },
			{ title: 'Slider', subtitle: '滑动输入条', icon: 'edit', url: '/pages/components/slider' },
			{ title: 'Switch', subtitle: '开关', icon: 'edit', url: '/pages/components/switch' },
			{ title: 'TimePicker', subtitle: '时间选择器', icon: 'edit', url: '/pages/components/time-picker' },
			{ title: 'Upload', subtitle: '上传', icon: 'edit', url: '/pages/components/upload' }
		]
	},
	{
		title: '数据展示',
		entries: [
			{ title: 'Avatar', subtitle: '头像', icon: 'file', url: '/pages/components/avatar' },
			{ title: 'AvatarGroup', subtitle: '头像组', icon: 'file', url: '/pages/components/avatar-group' },
			{ title: 'Badge', subtitle: '徽标数', icon: 'file', url: '/pages/components/badge' },
			{ title: 'Card', subtitle: '卡片', icon: 'file', url: '/pages/components/card' },
			{ title: 'Carousel', subtitle: '走马灯', icon: 'file', url: '/pages/components/carousel' },
			{ title: 'Collapse', subtitle: '折叠面板', icon: 'file', url: '/pages/components/collapse' },
			{ title: 'Descriptions', subtitle: '描述列表', icon: 'file', url: '/pages/components/descriptions' },
			{ title: 'Empty', subtitle: '空状态', icon: 'file', url: '/pages/components/empty' },
			{ title: 'Image', subtitle: '图片', icon: 'file', url: '/pages/components/image' },
			{ title: 'ImagePreview', subtitle: '图片预览', icon: 'file', url: '/pages/components/image-preview' },
			{ title: 'List', subtitle: '列表', icon: 'file', url: '/pages/components/list' },
			{ title: 'Result', subtitle: '结果', icon: 'file', url: '/pages/components/result' },
			{ title: 'Statistic', subtitle: '统计数值', icon: 'file', url: '/pages/components/statistic' },
			{ title: 'Tag', subtitle: '标签', icon: 'file', url: '/pages/components/tag' },
			{ title: 'Timeline', subtitle: '时间轴', icon: 'file', url: '/pages/components/timeline' },
			{ title: 'VirtualList', subtitle: '虚拟列表', icon: 'file', url: '/pages/components/virtual-list' },
			{ title: 'Watermark', subtitle: '水印', icon: 'file', url: '/pages/components/watermark' }
		]
	},
	{
		title: '反馈',
		entries: [
			{ title: 'ActionSheet', subtitle: '动作面板', icon: 'message', url: '/pages/components/action-sheet' },
			{ title: 'Alert', subtitle: '警告提示', icon: 'message', url: '/pages/components/alert' },
			{ title: 'Drawer', subtitle: '抽屉', icon: 'message', url: '/pages/components/drawer' },
			{ title: 'Mask', subtitle: '背景蒙层', icon: 'message', url: '/pages/components/mask' },
			{ title: 'Modal', subtitle: '对话框', icon: 'message', url: '/pages/components/modal' },
			{ title: 'NoticeBar', subtitle: '通告栏', icon: 'message', url: '/pages/components/notice-bar' },
			{ title: 'Popover', subtitle: '气泡卡片', icon: 'message', url: '/pages/components/popover' },
			{ title: 'Popup', subtitle: '弹出层', icon: 'message', url: '/pages/components/popup' },
			{ title: 'Progress', subtitle: '进度条', icon: 'message', url: '/pages/components/progress' },
			{ title: 'Skeleton', subtitle: '骨架屏', icon: 'message', url: '/pages/components/skeleton' },
			{ title: 'Spin', subtitle: '加载中', icon: 'message', url: '/pages/components/spin' },
			{ title: 'message / Toast', subtitle: '全局提示', icon: 'message', url: '/pages/components/message' }
		]
	},
	{
		title: '手势与其他',
		entries: [
			{ title: 'Affix', subtitle: '固钉', icon: 'setting', url: '/pages/components/affix' },
			{ title: 'FloatingPanel', subtitle: '浮动面板', icon: 'setting', url: '/pages/components/floating-panel' },
			{ title: 'InfiniteScroll', subtitle: '无限滚动', icon: 'setting', url: '/pages/components/infinite-scroll' },
			{ title: 'PullToRefresh', subtitle: '下拉刷新', icon: 'setting', url: '/pages/components/pull-to-refresh' },
			{ title: 'SwipeAction', subtitle: '滑动操作', icon: 'setting', url: '/pages/components/swipe-action' }
		]
	}
]

const keyword = ref('')

// 按标题或中文名过滤；没有命中的分组不显示
const visibleGroups = computed(() : DemoGroup[] => {
	const word = keyword.value.trim().toLowerCase()
	if (word.length == 0) return groups
	const list : DemoGroup[] = []
	groups.forEach((group : DemoGroup) => {
		const entries = group.entries.filter((entry : DemoEntry) : boolean => {
			return entry.title.toLowerCase().includes(word) || entry.subtitle.includes(word)
		})
		if (entries.length > 0) list.push({ title: group.title, entries: entries } as DemoGroup)
	})
	return list
})

const dark = computed(() : boolean => amThemeState.theme.isDark)
const english = computed(() : boolean => amLocaleState.locale.locale == enUS.locale)

// 只换明暗算法：主色、圆角、紧凑沿用当前的全局主题（ConfigProvider 示例页里可能改过）
function toggleDark() {
	const algorithm : string[] = [dark.value ? 'default' : 'dark']
	if (amThemeState.theme.isCompact) algorithm.push('compact')
	const config : AmThemeConfig = { algorithm: algorithm, token: amThemeState.config.token }
	setAmTheme(config)
}

function toggleLocale() {
	setAmLocale(english.value ? zhCN : enUS)
}

function open(url : string) {
	uni.navigateTo({ url: url })
}
</script>

<template>
	<am-config-provider>
		<view class="index__hero">
			<image class="index__logo" src="/static/logo.png" mode="aspectFit"></image>
			<view class="index__heading">
				<text class="index__title">Antdv Next Uni</text>
				<text class="index__subtitle">uni-app x 组件库，与 antdv-next-mobile 同名、同属性、同主题</text>
			</view>
		</view>
		<view class="index__tools">
			<view class="index__search">
				<am-input-search v-model:value="keyword" placeholder="搜索组件，如 Button / 按钮" />
			</view>
			<am-button class="index__tool" size="small" :type="dark ? 'primary' : 'default'" :text="dark ? '亮色' : '暗色'" @click="toggleDark" />
			<am-button class="index__tool" size="small" :text="english ? '中文' : 'EN'" @click="toggleLocale" />
		</view>
		<am-empty v-if="visibleGroups.length == 0" description="没有匹配的组件" />
		<am-list v-for="group in visibleGroups" :key="group.title" :header="group.title" mode="card">
			<am-list-item
				v-for="(entry, index) in group.entries"
				:key="entry.url"
				:title="entry.title"
				:extra="entry.subtitle"
				:prefix="entry.icon"
				:bordered="index < group.entries.length - 1"
				arrow
				@click="open(entry.url)"
			/>
		</am-list>
		<view class="index__footer"></view>
	</am-config-provider>
</template>

<style>
.index__hero { flex-direction: row; align-items: center; padding: 24px 16px 12px 16px; }
.index__logo { width: 56px; height: 56px; }
.index__heading { flex: 1; margin-left: 12px; }
.index__title { font-size: 22px; font-weight: bold; color: var(--am-color-text, rgba(0, 0, 0, 0.88)); }
.index__subtitle { margin-top: 4px; font-size: 13px; line-height: 20px; color: var(--am-color-text-secondary, rgba(0, 0, 0, 0.65)); }
.index__tools { flex-direction: row; align-items: center; padding: 0 16px 4px 16px; }
.index__search { flex: 1; }
.index__tool { margin-left: 8px; }
.index__footer { height: 32px; }
</style>

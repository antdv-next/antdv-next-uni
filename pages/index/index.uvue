import { amLocaleState, enUS, setAmLocale, zhCN } from '@/uni_modules/antdv-next-uni/locale/locale.uts'

// 示例 App 的首页：分组与 antdv-next-mobile 的文档相同；顶部可以搜索组件、切换全局暗色与语言
